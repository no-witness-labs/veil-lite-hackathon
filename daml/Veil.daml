module Veil where

import DA.Time (addRelTime, seconds)

data MarginCallDetails = MarginCallDetails
  with
    issuedAt : Time
    deadline : Time
    unitPrice : Decimal
  deriving (Eq, Show)

-- The counterparties authorize one price stream. Descendant prices retain
-- their signatures, so the valuer alone cannot fabricate a parallel branch.
template ValuationStream
  with
    valuationAgent : Party
    lender : Party
    borrower : Party
    regulator : Party
    collateralAsset : Text
  where
    signatory valuationAgent, lender, borrower
    observer regulator
    ensure collateralAsset /= "" && lender /= borrower
      && valuationAgent /= lender && valuationAgent /= borrower && valuationAgent /= regulator

    choice PublishInitial : ContractId CollateralValuation
      with
        unitPrice : Decimal
      controller valuationAgent
      do
        observedAt <- getTime
        create CollateralValuation with
          valuationAgent; lender; borrower; regulator; collateralAsset
          streamId = self
          unitPrice; observedAt

-- A current price is replaced, never appended. The archived predecessor can
-- no longer be fetched even inside the five-minute freshness window.
template CollateralValuation
  with
    valuationAgent : Party
    lender : Party
    borrower : Party
    regulator : Party
    collateralAsset : Text
    streamId : ContractId ValuationStream
    unitPrice : Decimal
    observedAt : Time
  where
    signatory valuationAgent, lender, borrower
    observer regulator
    ensure unitPrice > 0.0 && collateralAsset /= ""

    choice Publish : ContractId CollateralValuation
      with
        unitPrice : Decimal
      controller valuationAgent
      do
        observedAt <- getTime
        create this with unitPrice; observedAt

-- Check every use, including liquidation after a grace period. A mark must
-- identify this deal's counterparties and asset and be no more than 5 min old.
checkedPrice : Party -> Party -> Party -> Party -> Text -> ContractId ValuationStream -> ContractId CollateralValuation -> Update Decimal
checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid = do
  mark <- fetch valuationCid
  now <- getTime
  assertMsg "valuation agent mismatch" (mark.valuationAgent == valuationAgent)
  assertMsg "valuation counterparties mismatch"
    (mark.lender == lender && mark.borrower == borrower && mark.regulator == regulator)
  assertMsg "valuation asset mismatch" (mark.collateralAsset == collateralAsset)
  assertMsg "valuation stream mismatch" (mark.streamId == valuationStreamId)
  assertMsg "valuation cannot be from the future" (mark.observedAt <= now)
  assertMsg "valuation is stale" (now <= addRelTime mark.observedAt (seconds 300))
  pure mark.unitPrice

-- The demo issuer authorizes issuance. Spending choices carry that authority
-- forward without giving the owner permission to create arbitrary holdings.
template CashHolding
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory issuer, owner
    ensure amount > 0.0 && issuer /= owner

    -- | Lender funds a borrower-specific offer directly from cash. The funded
    -- principal leaves the lender here and is delivered to the borrower on
    -- Accept (or refunded on Withdraw). The issuer-signed offer is the escrow:
    -- its consuming choices can release this reserved principal only once.
    choice MakeOffer : ContractId LoanOffer
      with
        borrower : Party
        regulator : Party
        valuationAgent : Party
        valuationCid : ContractId CollateralValuation
        principal : Decimal
        interest : Decimal
        collateralAsset : Text
        collateralQuantity : Decimal
        maturity : Time
        liquidationThresholdLtv : Decimal
        marginCallWindowSeconds : Int
      controller owner
      do
        now <- getTime
        assertMsg "offer maturity must be in the future" (now < maturity)
        assertMsg "principal must be positive" (principal > 0.0)
        mark <- fetch valuationCid
        unitPrice <- checkedPrice valuationAgent owner borrower regulator collateralAsset mark.streamId valuationCid
        assertMsg "collateral quantity must be positive" (collateralQuantity > 0.0)
        assertMsg "offer LTV must be below the liquidation threshold"
          ((principal / (collateralQuantity * unitPrice)) * 100.0 < liquidationThresholdLtv)
        assertMsg "insufficient cash to fund offer" (amount >= principal)
        if amount > principal
          then do
            _ <- create CashHolding with issuer; owner; amount = amount - principal
            pure ()
          else pure ()
        create LoanOffer with
          issuer
          lender = owner
          borrower
          regulator
          valuationAgent
          valuationStreamId = mark.streamId
          principal
          interest
          collateralAsset
          collateralQuantity
          maturity
          liquidationThresholdLtv
          marginCallWindowSeconds
    
    choice Split : (ContractId CashHolding, ContractId CashHolding)
      with
        splitAmount : Decimal
      controller owner
      do
        assertMsg "split amount must be positive and less than total amount" (splitAmount > 0.0 && splitAmount < amount)
        let remainingAmount = amount - splitAmount
        cid1 <- create CashHolding with issuer; owner; amount = splitAmount
        cid2 <- create CashHolding with issuer; owner; amount = remainingAmount
        pure (cid1, cid2)

-- Demo collateral uses the same controlled issuer. It is simulated inventory,
-- not a claim that Treasury/MMF units are actually held by a custodian.
template CollateralHolding
  with
    issuer : Party
    owner : Party
    asset : Text
    quantity : Decimal
  where
    signatory issuer, owner
    ensure quantity > 0.0 && asset /= "" && issuer /= owner

    -- Carve out the intended deposit privately before a Loan choice fetches it.
    choice SplitCollateral : (ContractId CollateralHolding, ContractId CollateralHolding)
      with
        splitQuantity : Decimal
      controller owner
      do
        assertMsg "split quantity must be positive and less than total quantity"
          (splitQuantity > 0.0 && splitQuantity < quantity)
        exact <- create CollateralHolding with issuer; owner; asset; quantity = splitQuantity
        remainder <- create CollateralHolding with issuer; owner; asset; quantity = quantity - splitQuantity
        pure (exact, remainder)

-- | Borrower-specific loan offer for a known-counterparty lending flow.
--
-- The lender commits the terms; the issuer's signature carries the reserved
-- principal from CashHolding.MakeOffer. A lender cannot construct trusted
-- escrow directly. The trusted issuer can authorize issuance by definition.
template LoanOffer
  with
    issuer : Party
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    valuationStreamId : ContractId ValuationStream
    principal : Decimal
    interest : Decimal
    collateralAsset : Text
    collateralQuantity : Decimal
    maturity : Time
    liquidationThresholdLtv : Decimal
    marginCallWindowSeconds : Int
  where
    signatory issuer, lender
    observer borrower, regulator

    ensure principal > 0.0 && interest >= 0.0 && collateralQuantity > 0.0
      && liquidationThresholdLtv > 0.0 && liquidationThresholdLtv <= 100.0
      && marginCallWindowSeconds >= 60 && marginCallWindowSeconds <= 86400
      && lender /= borrower && collateralAsset /= ""
      && valuationAgent /= lender && valuationAgent /= borrower && valuationAgent /= regulator
      && issuer /= lender && issuer /= borrower && issuer /= regulator && issuer /= valuationAgent

    -- | Borrower locks matching collateral and draws the principal. The
    -- borrower's CollateralHolding is consumed (encumbered in the loan) and a
    -- CashHolding for the principal is delivered to the borrower.
    choice Accept : ContractId Loan
      with
        collateralCid : ContractId CollateralHolding
        valuationCid : ContractId CollateralValuation
      controller borrower
      do
        now <- getTime
        assertMsg "cannot accept an offer at or after maturity" (now < maturity)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        assertMsg "acceptance LTV must be below the liquidation threshold"
          ((principal / (collateralQuantity * unitPrice)) * 100.0 < liquidationThresholdLtv)
        collateral <- fetch collateralCid
        assertMsg "collateral issuer mismatch" (collateral.issuer == issuer)
        assertMsg "collateral must be owned by the borrower" (collateral.owner == borrower)
        assertMsg "collateral asset mismatch" (collateral.asset == collateralAsset)
        assertMsg "collateral quantity mismatch" (collateral.quantity == collateralQuantity)
        archive collateralCid
        _ <- create CashHolding with issuer; owner = borrower; amount = principal
        create Loan with
          issuer
          lender
          borrower
          regulator
          valuationAgent
          valuationStreamId
          principal
          interest
          collateralAsset
          collateralQuantity
          maturity
          liquidationThresholdLtv
          marginCallWindowSeconds
          marginCall = None
          collateralLocked = True

    -- | Lender withdraws the unaccepted offer; the pre-funded principal is
    -- refunded to the lender.
    choice Withdraw : ContractId CashHolding
      controller lender
      do
        create CashHolding with issuer; owner = lender; amount = principal

-- | Active private bilateral loan created after the borrower accepts an offer.
--
-- The issuer carries the locked collateral's authority through the lifecycle.
-- Lender and borrower authorize their shared obligation; regulator observes.
template Loan
  with
    issuer : Party
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    valuationStreamId : ContractId ValuationStream
    principal : Decimal
    interest : Decimal
    collateralAsset : Text
    collateralQuantity : Decimal
    maturity : Time
    liquidationThresholdLtv : Decimal
    marginCallWindowSeconds : Int
    marginCall : Optional MarginCallDetails
    collateralLocked : Bool
  where
    signatory issuer, lender, borrower
    observer regulator

    ensure principal > 0.0 && interest >= 0.0 && collateralQuantity > 0.0
      && liquidationThresholdLtv > 0.0 && liquidationThresholdLtv <= 100.0
      && marginCallWindowSeconds >= 60 && marginCallWindowSeconds <= 86400
      && lender /= borrower && collateralAsset /= "" && collateralLocked
      && valuationAgent /= lender && valuationAgent /= borrower && valuationAgent /= regulator
      && issuer /= lender && issuer /= borrower && issuer /= regulator && issuer /= valuationAgent

    -- Consuming the Loan prevents a parallel call or a reset of its deadline.
    choice IssueMarginCall : ContractId Loan
      with
        valuationCid : ContractId CollateralValuation
      controller lender
      do
        now <- getTime
        assertMsg "cannot issue a margin call at or after maturity" (now < maturity)
        assertMsg "a margin call is already open" (marginCall == None)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        assertMsg "margin call requires an LTV breach"
          ((principal / (collateralQuantity * unitPrice)) * 100.0 >= liquidationThresholdLtv)
        let call = MarginCallDetails with
              issuedAt = now
              deadline = addRelTime now (seconds marginCallWindowSeconds)
              unitPrice
        create this with marginCall = Some call

    choice TopUpCollateral : ContractId Loan
      with
        collateralCid : ContractId CollateralHolding
        topUpQuantity : Decimal
        valuationCid : ContractId CollateralValuation
      controller borrower
      do
        call <- case marginCall of
          None -> abort "no margin call is open"
          Some call -> pure call
        now <- getTime
        assertMsg "cannot top up at or after maturity" (now < maturity)
        assertMsg "margin call deadline has passed" (now < call.deadline)
        assertMsg "top-up quantity must be positive" (topUpQuantity > 0.0)
        collateral <- fetch collateralCid
        assertMsg "top-up issuer mismatch" (collateral.issuer == issuer)
        assertMsg "top-up must be owned by the borrower" (collateral.owner == borrower)
        assertMsg "top-up asset mismatch" (collateral.asset == collateralAsset)
        assertMsg "top-up must use an exact holding; split privately first" (collateral.quantity == topUpQuantity)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        let totalQuantity = collateralQuantity + topUpQuantity
        assertMsg "top-up must restore LTV below the threshold"
          ((principal / (totalQuantity * unitPrice)) * 100.0 < liquidationThresholdLtv)
        archive collateralCid
        create this with collateralQuantity = totalQuantity; marginCall = None

    -- A recovered price can cure the call without an unnecessary deposit.
    choice ResolveMarginCall : ContractId Loan
      with
        valuationCid : ContractId CollateralValuation
      controller borrower
      do
        now <- getTime
        assertMsg "cannot resolve a margin call at or after maturity" (now < maturity)
        assertMsg "no margin call is open" (marginCall /= None)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        assertMsg "collateral remains below the required value"
          ((principal / (collateralQuantity * unitPrice)) * 100.0 < liquidationThresholdLtv)
        create this with marginCall = None

    -- | Borrower repays principal + interest in cash and gets collateral back.
    -- Split privately first: only the exact payment is disclosed to this loan.
    choice Repay : ContractId LoanClosed
      with
        repaymentCid : ContractId CashHolding
      controller borrower
      do
        let repayment = principal + interest
        cash <- fetch repaymentCid
        assertMsg "repayment issuer mismatch" (cash.issuer == issuer)
        assertMsg "repayment cash must be owned by the borrower" (cash.owner == borrower)
        assertMsg "repayment amount mismatch" (cash.amount == repayment)
        archive repaymentCid
        _ <- create CashHolding with issuer; owner = lender; amount = repayment
        _ <- create CollateralHolding with issuer; owner = borrower; asset = collateralAsset; quantity = collateralQuantity
        create LoanClosed with
          issuer
          lender
          borrower
          regulator
          valuationAgent
          valuationStreamId
          principal
          interest
          collateralAsset
          collateralQuantity
          maturity
          reason = "Repaid"
          collateralReleased = True

    -- | A call must have expired and a fresh attested mark must still show a
    -- breach. There is no lender-supplied price or grace-period bypass.
    choice Liquidate : ContractId LoanClosed
      with
        valuationCid : ContractId CollateralValuation
      controller lender
      do
        call <- case marginCall of
          None -> abort "liquidation requires an open margin call"
          Some call -> pure call
        now <- getTime
        assertMsg "margin call deadline has not passed" (now >= call.deadline)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        assertMsg "liquidation requires an LTV breach"
          ((principal / (collateralQuantity * unitPrice)) * 100.0 >= liquidationThresholdLtv)
        _ <- create CollateralHolding with issuer; owner = lender; asset = collateralAsset; quantity = collateralQuantity
        create LoanClosed with
          issuer
          lender
          borrower
          regulator
          valuationAgent
          valuationStreamId
          principal
          interest
          collateralAsset
          collateralQuantity
          maturity
          reason = "Liquidated"
          collateralReleased = False

    -- Repayment default is distinct from a price breach. Repayment can still
    -- win the race; either consuming choice closes the loan exactly once.
    choice LiquidateOverdue : ContractId LoanClosed
      controller lender
      do
        now <- getTime
        assertMsg "loan is not past maturity" (now > maturity)
        _ <- create CollateralHolding with issuer; owner = lender; asset = collateralAsset; quantity = collateralQuantity
        create LoanClosed with
          issuer; lender; borrower; regulator; valuationAgent; valuationStreamId
          principal; interest; collateralAsset; collateralQuantity; maturity
          reason = "LiquidatedAtMaturity"
          collateralReleased = False

-- | Terminal settlement record created when a loan closes, either through
-- borrower repayment or lender liquidation.
--
-- The issuer and counterparties retain a shared settlement record. The
-- regulator keeps observer visibility, while an outsider still sees nothing.
template LoanClosed
  with
    issuer : Party
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    valuationStreamId : ContractId ValuationStream
    principal : Decimal
    interest : Decimal
    collateralAsset : Text
    collateralQuantity : Decimal
    maturity : Time
    reason : Text
    collateralReleased : Bool
  where
    signatory issuer, lender, borrower
    observer regulator

    ensure principal > 0.0 && interest >= 0.0 && collateralQuantity > 0.0
      && collateralAsset /= "" && lender /= borrower
      && issuer /= lender && issuer /= borrower && issuer /= regulator && issuer /= valuationAgent

    -- | Archive the settlement record. Used to clear ledger state when the
    -- demo is reset; the closed loan has already settled.
    choice Dismiss : ()
      controller lender
      do
        pure ()
