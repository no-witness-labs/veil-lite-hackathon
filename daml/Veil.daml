module Veil where

import DA.Optional (fromOptional)
import DA.Time (addRelTime, days, seconds)
import Splice.Api.Token.AllocationInstructionV2 qualified as Instr
import Splice.Api.Token.AllocationV2 qualified as Token
import Splice.Api.Token.HoldingV2 qualified as Holding
import Splice.Api.Token.MetadataV1 (ExtraArgs, emptyMetadata)

data MarginCallDetails = MarginCallDetails
  with
    issuedAt : Time
    deadline : Time
    unitPrice : Decimal
  deriving (Eq, Show)

-- The counterparties authorize one price stream. Descendant prices retain
-- their signatures, so the valuer alone cannot fabricate a parallel branch.
template ValuationStream
  with
    valuationAgent : Party
    lender : Party
    borrower : Party
    regulator : Party
    collateralAsset : Text
  where
    signatory valuationAgent, lender, borrower
    observer regulator
    ensure collateralAsset /= "" && lender /= borrower
      && valuationAgent /= lender && valuationAgent /= borrower && valuationAgent /= regulator

    choice PublishInitial : ContractId CollateralValuation
      with
        unitPrice : Decimal
      controller valuationAgent
      do
        observedAt <- getTime
        create CollateralValuation with
          valuationAgent; lender; borrower; regulator; collateralAsset
          streamId = self
          unitPrice; observedAt

-- A current price is replaced, never appended. The archived predecessor can
-- no longer be fetched even inside the five-minute freshness window.
template CollateralValuation
  with
    valuationAgent : Party
    lender : Party
    borrower : Party
    regulator : Party
    collateralAsset : Text
    streamId : ContractId ValuationStream
    unitPrice : Decimal
    observedAt : Time
  where
    signatory valuationAgent, lender, borrower
    observer regulator
    ensure unitPrice > 0.0 && collateralAsset /= ""

    choice Publish : ContractId CollateralValuation
      with
        unitPrice : Decimal
      controller valuationAgent
      do
        observedAt <- getTime
        create this with unitPrice; observedAt

-- Check every use, including liquidation after a grace period. A mark must
-- identify this deal's counterparties and asset and be no more than 5 min old.
checkedPrice : Party -> Party -> Party -> Party -> Text -> ContractId ValuationStream -> ContractId CollateralValuation -> Update Decimal
checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid = do
  mark <- fetch valuationCid
  now <- getTime
  assertMsg "valuation agent mismatch" (mark.valuationAgent == valuationAgent)
  assertMsg "valuation counterparties mismatch"
    (mark.lender == lender && mark.borrower == borrower && mark.regulator == regulator)
  assertMsg "valuation asset mismatch" (mark.collateralAsset == collateralAsset)
  assertMsg "valuation stream mismatch" (mark.streamId == valuationStreamId)
  assertMsg "valuation cannot be from the future" (mark.observedAt <= now)
  assertMsg "valuation is stale" (now <= addRelTime mark.observedAt (seconds 300))
  pure mark.unitPrice

-- Partial payments settle the fixed interest first, then principal. The
-- agreed terms stay on the contract; only the running total changes.
repaidTotal : Optional Decimal -> Decimal
repaidTotal = fromOptional 0.0

outstandingPrincipal : Decimal -> Decimal -> Optional Decimal -> Decimal
outstandingPrincipal principal interest amountRepaid = principal - max 0.0 (repaidTotal amountRepaid - interest)

-- The demo issuer authorizes issuance. Spending choices carry that authority
-- forward without giving the owner permission to create arbitrary holdings.
template CashHolding
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory issuer, owner
    ensure amount > 0.0 && issuer /= owner

    -- | Lender funds a borrower-specific offer directly from cash. The funded
    -- principal leaves the lender here and is delivered to the borrower on
    -- Accept (or refunded on Withdraw). The issuer-signed offer is the escrow:
    -- its consuming choices can release this reserved principal only once.
    choice MakeOffer : ContractId LoanOffer
      with
        borrower : Party
        regulator : Party
        valuationAgent : Party
        valuationCid : ContractId CollateralValuation
        principal : Decimal
        interest : Decimal
        collateralAsset : Text
        collateralQuantity : Decimal
        maturity : Time
        liquidationThresholdLtv : Decimal
        marginCallWindowSeconds : Int
      controller owner
      do
        now <- getTime
        assertMsg "offer maturity must be in the future" (now < maturity)
        assertMsg "principal must be positive" (principal > 0.0)
        mark <- fetch valuationCid
        unitPrice <- checkedPrice valuationAgent owner borrower regulator collateralAsset mark.streamId valuationCid
        assertMsg "collateral quantity must be positive" (collateralQuantity > 0.0)
        assertMsg "offer LTV must be below the liquidation threshold"
          ((principal / (collateralQuantity * unitPrice)) * 100.0 < liquidationThresholdLtv)
        assertMsg "insufficient cash to fund offer" (amount >= principal)
        if amount > principal
          then do
            _ <- create CashHolding with issuer; owner; amount = amount - principal
            pure ()
          else pure ()
        create LoanOffer with
          issuer
          lender = owner
          borrower
          regulator
          valuationAgent
          valuationStreamId = mark.streamId
          principal
          interest
          collateralAsset
          collateralQuantity
          maturity
          liquidationThresholdLtv
          marginCallWindowSeconds
    
    -- | Lender funds an offer secured by real Canton Coin. The principal is
    -- escrowed exactly as in MakeOffer; the collateral side is only a quantity
    -- until the borrower locks it in a committed allocation on acceptance.
    choice MakeCoinOffer : ContractId CoinLoanOffer
      with
        borrower : Party
        regulator : Party
        valuationAgent : Party
        valuationCid : ContractId CollateralValuation
        coinAdmin : Party
        principal : Decimal
        interest : Decimal
        collateralQuantity : Decimal
        maturity : Time
        liquidationThresholdLtv : Decimal
        marginCallWindowSeconds : Int
        settlementRef : Text
      controller owner
      do
        now <- getTime
        assertMsg "offer maturity must be in the future" (now < maturity)
        assertMsg "principal must be positive" (principal > 0.0)
        mark <- fetch valuationCid
        unitPrice <- checkedPrice valuationAgent owner borrower regulator coinAsset mark.streamId valuationCid
        assertMsg "collateral quantity must be positive" (collateralQuantity > 0.0)
        assertMsg "offer LTV must be below the liquidation threshold"
          ((principal / (collateralQuantity * unitPrice)) * 100.0 < liquidationThresholdLtv)
        assertMsg "insufficient cash to fund offer" (amount >= principal)
        if amount > principal
          then do
            _ <- create CashHolding with issuer; owner; amount = amount - principal
            pure ()
          else pure ()
        create CoinLoanOffer with
          issuer
          lender = owner
          borrower
          regulator
          valuationAgent
          valuationStreamId = mark.streamId
          coinAdmin
          principal
          interest
          collateralQuantity
          maturity
          liquidationThresholdLtv
          marginCallWindowSeconds
          settlementRef

    choice Split : (ContractId CashHolding, ContractId CashHolding)
      with
        splitAmount : Decimal
      controller owner
      do
        assertMsg "split amount must be positive and less than total amount" (splitAmount > 0.0 && splitAmount < amount)
        let remainingAmount = amount - splitAmount
        cid1 <- create CashHolding with issuer; owner; amount = splitAmount
        cid2 <- create CashHolding with issuer; owner; amount = remainingAmount
        pure (cid1, cid2)

-- Demo collateral uses the same controlled issuer. It is simulated inventory,
-- not a claim that Treasury/MMF units are actually held by a custodian.
template CollateralHolding
  with
    issuer : Party
    owner : Party
    asset : Text
    quantity : Decimal
  where
    signatory issuer, owner
    ensure quantity > 0.0 && asset /= "" && issuer /= owner

    -- Escrow a replacement holding for an open loan. The lender can see the
    -- request (and so approve it) without ever fetching the borrower's wallet.
    choice ProposeSubstitution : ContractId SubstitutionRequest
      with
        lender : Party
        regulator : Party
        valuationAgent : Party
        releaseAsset : Text
        releaseQuantity : Decimal
        newValuationStreamId : ContractId ValuationStream
      controller owner
      do
        create SubstitutionRequest with
          issuer; lender; borrower = owner; regulator; valuationAgent
          releaseAsset; releaseQuantity
          newAsset = asset; newQuantity = quantity; newValuationStreamId

    -- Carve out the intended deposit privately before a Loan choice fetches it.
    choice SplitCollateral : (ContractId CollateralHolding, ContractId CollateralHolding)
      with
        splitQuantity : Decimal
      controller owner
      do
        assertMsg "split quantity must be positive and less than total quantity"
          (splitQuantity > 0.0 && splitQuantity < quantity)
        exact <- create CollateralHolding with issuer; owner; asset; quantity = splitQuantity
        remainder <- create CollateralHolding with issuer; owner; asset; quantity = quantity - splitQuantity
        pure (exact, remainder)

-- | Borrower's request to swap an open loan's collateral for another asset.
--
-- The replacement is held here in escrow, with the issuer's signature carried
-- from the consumed holding. The request names the collateral it expects to
-- release, so a top-up or an earlier substitution invalidates it. The lender
-- applies it through Loan.ApplySubstitution or rejects it; either side's exit
-- returns the escrowed holding exactly once.
template SubstitutionRequest
  with
    issuer : Party
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    releaseAsset : Text
    releaseQuantity : Decimal
    newAsset : Text
    newQuantity : Decimal
    newValuationStreamId : ContractId ValuationStream
  where
    signatory issuer, borrower
    observer lender, regulator

    ensure newQuantity > 0.0 && releaseQuantity > 0.0 && newAsset /= "" && releaseAsset /= ""
      && newAsset /= releaseAsset && lender /= borrower && issuer /= borrower && issuer /= lender

    choice RejectSubstitution : ContractId CollateralHolding
      controller lender
      do
        create CollateralHolding with issuer; owner = borrower; asset = newAsset; quantity = newQuantity

    choice CancelSubstitution : ContractId CollateralHolding
      controller borrower
      do
        create CollateralHolding with issuer; owner = borrower; asset = newAsset; quantity = newQuantity

-- | Borrower-specific loan offer for a known-counterparty lending flow.
--
-- The lender commits the terms; the issuer's signature carries the reserved
-- principal from CashHolding.MakeOffer. A lender cannot construct trusted
-- escrow directly. The trusted issuer can authorize issuance by definition.
template LoanOffer
  with
    issuer : Party
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    valuationStreamId : ContractId ValuationStream
    principal : Decimal
    interest : Decimal
    collateralAsset : Text
    collateralQuantity : Decimal
    maturity : Time
    liquidationThresholdLtv : Decimal
    marginCallWindowSeconds : Int
  where
    signatory issuer, lender
    observer borrower, regulator

    ensure principal > 0.0 && interest >= 0.0 && collateralQuantity > 0.0
      && liquidationThresholdLtv > 0.0 && liquidationThresholdLtv <= 100.0
      && marginCallWindowSeconds >= 60 && marginCallWindowSeconds <= 86400
      && lender /= borrower && collateralAsset /= ""
      && valuationAgent /= lender && valuationAgent /= borrower && valuationAgent /= regulator
      && issuer /= lender && issuer /= borrower && issuer /= regulator && issuer /= valuationAgent

    -- | Borrower locks matching collateral and draws the principal. The
    -- borrower's CollateralHolding is consumed (encumbered in the loan) and a
    -- CashHolding for the principal is delivered to the borrower.
    choice Accept : ContractId Loan
      with
        collateralCid : ContractId CollateralHolding
        valuationCid : ContractId CollateralValuation
      controller borrower
      do
        now <- getTime
        assertMsg "cannot accept an offer at or after maturity" (now < maturity)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        assertMsg "acceptance LTV must be below the liquidation threshold"
          ((principal / (collateralQuantity * unitPrice)) * 100.0 < liquidationThresholdLtv)
        collateral <- fetch collateralCid
        assertMsg "collateral issuer mismatch" (collateral.issuer == issuer)
        assertMsg "collateral must be owned by the borrower" (collateral.owner == borrower)
        assertMsg "collateral asset mismatch" (collateral.asset == collateralAsset)
        assertMsg "collateral quantity mismatch" (collateral.quantity == collateralQuantity)
        archive collateralCid
        _ <- create CashHolding with issuer; owner = borrower; amount = principal
        create Loan with
          issuer
          lender
          borrower
          regulator
          valuationAgent
          valuationStreamId
          principal
          interest
          collateralAsset
          collateralQuantity
          maturity
          liquidationThresholdLtv
          marginCallWindowSeconds
          marginCall = None
          collateralLocked = True
          amountRepaid = None

    -- | Lender withdraws the unaccepted offer; the pre-funded principal is
    -- refunded to the lender.
    choice Withdraw : ContractId CashHolding
      controller lender
      do
        create CashHolding with issuer; owner = lender; amount = principal

-- | Active private bilateral loan created after the borrower accepts an offer.
--
-- The issuer carries the locked collateral's authority through the lifecycle.
-- Lender and borrower authorize their shared obligation; regulator observes.
template Loan
  with
    issuer : Party
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    valuationStreamId : ContractId ValuationStream
    principal : Decimal
    interest : Decimal
    collateralAsset : Text
    collateralQuantity : Decimal
    maturity : Time
    liquidationThresholdLtv : Decimal
    marginCallWindowSeconds : Int
    marginCall : Optional MarginCallDetails
    collateralLocked : Bool
    amountRepaid : Optional Decimal
  where
    signatory issuer, lender, borrower
    observer regulator

    ensure principal > 0.0 && interest >= 0.0 && collateralQuantity > 0.0
      && liquidationThresholdLtv > 0.0 && liquidationThresholdLtv <= 100.0
      && marginCallWindowSeconds >= 60 && marginCallWindowSeconds <= 86400
      && lender /= borrower && collateralAsset /= "" && collateralLocked
      && repaidTotal amountRepaid >= 0.0 && repaidTotal amountRepaid < principal + interest
      && valuationAgent /= lender && valuationAgent /= borrower && valuationAgent /= regulator
      && issuer /= lender && issuer /= borrower && issuer /= regulator && issuer /= valuationAgent

    -- Consuming the Loan prevents a parallel call or a reset of its deadline.
    choice IssueMarginCall : ContractId Loan
      with
        valuationCid : ContractId CollateralValuation
      controller lender
      do
        now <- getTime
        assertMsg "cannot issue a margin call at or after maturity" (now < maturity)
        assertMsg "a margin call is already open" (marginCall == None)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        assertMsg "margin call requires an LTV breach"
          ((outstandingPrincipal principal interest amountRepaid / (collateralQuantity * unitPrice)) * 100.0 >= liquidationThresholdLtv)
        let call = MarginCallDetails with
              issuedAt = now
              deadline = addRelTime now (seconds marginCallWindowSeconds)
              unitPrice
        create this with marginCall = Some call

    choice TopUpCollateral : ContractId Loan
      with
        collateralCid : ContractId CollateralHolding
        topUpQuantity : Decimal
        valuationCid : ContractId CollateralValuation
      controller borrower
      do
        call <- case marginCall of
          None -> abort "no margin call is open"
          Some call -> pure call
        now <- getTime
        assertMsg "cannot top up at or after maturity" (now < maturity)
        assertMsg "margin call deadline has passed" (now < call.deadline)
        assertMsg "top-up quantity must be positive" (topUpQuantity > 0.0)
        collateral <- fetch collateralCid
        assertMsg "top-up issuer mismatch" (collateral.issuer == issuer)
        assertMsg "top-up must be owned by the borrower" (collateral.owner == borrower)
        assertMsg "top-up asset mismatch" (collateral.asset == collateralAsset)
        assertMsg "top-up must use an exact holding; split privately first" (collateral.quantity == topUpQuantity)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        let totalQuantity = collateralQuantity + topUpQuantity
        assertMsg "top-up must restore LTV below the threshold"
          ((outstandingPrincipal principal interest amountRepaid / (totalQuantity * unitPrice)) * 100.0 < liquidationThresholdLtv)
        archive collateralCid
        create this with collateralQuantity = totalQuantity; marginCall = None

    -- A recovered price can cure the call without an unnecessary deposit.
    choice ResolveMarginCall : ContractId Loan
      with
        valuationCid : ContractId CollateralValuation
      controller borrower
      do
        now <- getTime
        assertMsg "cannot resolve a margin call at or after maturity" (now < maturity)
        assertMsg "no margin call is open" (marginCall /= None)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        assertMsg "collateral remains below the required value"
          ((outstandingPrincipal principal interest amountRepaid / (collateralQuantity * unitPrice)) * 100.0 < liquidationThresholdLtv)
        create this with marginCall = None

    -- | Lender approves a collateral substitution. In one transaction the
    -- escrowed replacement becomes the locked collateral, the loan is rebound to
    -- the replacement asset's jointly authorized price stream, and the released
    -- collateral returns to the borrower. Coverage is re-checked on a fresh mark
    -- of the new asset; the substitution cannot cure or bypass an open call.
    choice ApplySubstitution : ContractId Loan
      with
        requestCid : ContractId SubstitutionRequest
        newValuationCid : ContractId CollateralValuation
      controller lender
      do
        now <- getTime
        assertMsg "cannot substitute at or after maturity" (now < maturity)
        assertMsg "cannot substitute while a margin call is open" (marginCall == None)
        request <- fetch requestCid
        assertMsg "substitution parties mismatch"
          (request.issuer == issuer && request.lender == lender && request.borrower == borrower
            && request.regulator == regulator && request.valuationAgent == valuationAgent)
        assertMsg "substitution no longer matches the locked collateral"
          (request.releaseAsset == collateralAsset && request.releaseQuantity == collateralQuantity)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator request.newAsset request.newValuationStreamId newValuationCid
        assertMsg "substituted collateral must keep LTV below the threshold"
          ((outstandingPrincipal principal interest amountRepaid / (request.newQuantity * unitPrice)) * 100.0 < liquidationThresholdLtv)
        archive requestCid
        _ <- create CollateralHolding with issuer; owner = borrower; asset = collateralAsset; quantity = collateralQuantity
        create this with
          collateralAsset = request.newAsset
          collateralQuantity = request.newQuantity
          valuationStreamId = request.newValuationStreamId

    -- | Borrower pays part of the balance with an exact cash holding. With a
    -- margin call open, the payment must cure it on a fresh mark; otherwise it
    -- simply reduces what is owed. Full settlement stays with Repay, which is
    -- the only choice that releases collateral.
    choice PartialRepay : ContractId Loan
      with
        paymentCid : ContractId CashHolding
        valuationCid : Optional (ContractId CollateralValuation)
      controller borrower
      do
        now <- getTime
        assertMsg "cannot pay down at or after maturity" (now < maturity)
        cash <- fetch paymentCid
        assertMsg "payment issuer mismatch" (cash.issuer == issuer)
        assertMsg "payment cash must be owned by the borrower" (cash.owner == borrower)
        let paid = repaidTotal amountRepaid + cash.amount
        assertMsg "a partial payment must be less than the outstanding balance; use Repay to settle"
          (paid < principal + interest)
        let remainingPrincipal = outstandingPrincipal principal interest (Some paid)
        cured <- case marginCall of
          None -> pure False
          Some _ -> do
            markCid <- case valuationCid of
              None -> abort "a fresh valuation is required to pay down during a margin call"
              Some markCid -> pure markCid
            unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId markCid
            assertMsg "payment must restore LTV below the threshold while a margin call is open"
              ((remainingPrincipal / (collateralQuantity * unitPrice)) * 100.0 < liquidationThresholdLtv)
            pure True
        archive paymentCid
        _ <- create CashHolding with issuer; owner = lender; amount = cash.amount
        create this with
          amountRepaid = Some paid
          marginCall = if cured then None else marginCall

    -- | Borrower repays principal + interest in cash and gets collateral back.
    -- Split privately first: only the exact payment is disclosed to this loan.
    choice Repay : ContractId LoanClosed
      with
        repaymentCid : ContractId CashHolding
      controller borrower
      do
        let repayment = principal + interest - repaidTotal amountRepaid
        cash <- fetch repaymentCid
        assertMsg "repayment issuer mismatch" (cash.issuer == issuer)
        assertMsg "repayment cash must be owned by the borrower" (cash.owner == borrower)
        assertMsg "repayment amount mismatch" (cash.amount == repayment)
        archive repaymentCid
        _ <- create CashHolding with issuer; owner = lender; amount = repayment
        _ <- create CollateralHolding with issuer; owner = borrower; asset = collateralAsset; quantity = collateralQuantity
        create LoanClosed with
          issuer
          lender
          borrower
          regulator
          valuationAgent
          valuationStreamId
          principal
          interest
          collateralAsset
          collateralQuantity
          maturity
          reason = "Repaid"
          collateralReleased = True
          amountRepaid = Some (principal + interest)

    -- | A call must have expired and a fresh attested mark must still show a
    -- breach. There is no lender-supplied price or grace-period bypass.
    choice Liquidate : ContractId LoanClosed
      with
        valuationCid : ContractId CollateralValuation
      controller lender
      do
        call <- case marginCall of
          None -> abort "liquidation requires an open margin call"
          Some call -> pure call
        now <- getTime
        assertMsg "margin call deadline has not passed" (now >= call.deadline)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        assertMsg "liquidation requires an LTV breach"
          ((outstandingPrincipal principal interest amountRepaid / (collateralQuantity * unitPrice)) * 100.0 >= liquidationThresholdLtv)
        _ <- create CollateralHolding with issuer; owner = lender; asset = collateralAsset; quantity = collateralQuantity
        create LoanClosed with
          issuer
          lender
          borrower
          regulator
          valuationAgent
          valuationStreamId
          principal
          interest
          collateralAsset
          collateralQuantity
          maturity
          reason = "Liquidated"
          collateralReleased = False
          amountRepaid

    -- Repayment default is distinct from a price breach. Repayment can still
    -- win the race; either consuming choice closes the loan exactly once.
    choice LiquidateOverdue : ContractId LoanClosed
      controller lender
      do
        now <- getTime
        assertMsg "loan is not past maturity" (now > maturity)
        _ <- create CollateralHolding with issuer; owner = lender; asset = collateralAsset; quantity = collateralQuantity
        create LoanClosed with
          issuer; lender; borrower; regulator; valuationAgent; valuationStreamId
          principal; interest; collateralAsset; collateralQuantity; maturity
          reason = "LiquidatedAtMaturity"
          collateralReleased = False
          amountRepaid

-- | Terminal settlement record created when a loan closes, either through
-- borrower repayment or lender liquidation.
--
-- The issuer and counterparties retain a shared settlement record. The
-- regulator keeps observer visibility, while an outsider still sees nothing.
template LoanClosed
  with
    issuer : Party
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    valuationStreamId : ContractId ValuationStream
    principal : Decimal
    interest : Decimal
    collateralAsset : Text
    collateralQuantity : Decimal
    maturity : Time
    reason : Text
    collateralReleased : Bool
    amountRepaid : Optional Decimal
  where
    signatory issuer, lender, borrower
    observer regulator

    ensure principal > 0.0 && interest >= 0.0 && collateralQuantity > 0.0
      && collateralAsset /= "" && lender /= borrower
      && issuer /= lender && issuer /= borrower && issuer /= regulator && issuer /= valuationAgent

    -- | Archive the settlement record. Used to clear ledger state when the
    -- demo is reset; the closed loan has already settled.
    choice Dismiss : ()
      controller lender
      do
        pure ()

-- ---------------------------------------------------------------------------
-- Canton Coin collateral (CIP-112 Token Standard V2)
--
-- The borrower's Canton Coin is locked in a *committed* allocation whose only
-- executor is the lender. The token standard itself refuses the borrower's
-- withdrawal until the settlement deadline; the lender can settle it (liquidate)
-- or cancel it (release on repayment). Veil records the allocation and decides
-- which of the two is allowed.

-- | Valuation-stream asset name for Canton Coin marks.
coinAsset : Text
coinAsset = "Canton Coin"

-- | Registry instrument id of Canton Coin.
coinInstrumentId : Text
coinInstrumentId = "Amulet"

coinAccount : Party -> Holding.Account
coinAccount party = Holding.Account with owner = Some party; provider = None; id = ""

coinSettlement : Party -> Text -> Token.SettlementInfo
coinSettlement lender settlementRef = Token.SettlementInfo with
  executors = [lender]
  id = settlementRef
  cid = None
  meta = emptyMetadata

-- | The lock must outlive maturity so overdue liquidation remains possible; a
-- day after maturity the borrower may withdraw whatever was never settled.
coinSettlementDeadline : Time -> Time
coinSettlementDeadline maturity = addRelTime maturity (days 1)

coinCollateralLeg : Token.TransferSide -> Party -> Decimal -> Token.TransferLegSide
coinCollateralLeg side otherside quantity = Token.TransferLegSide with
  transferLegId = "collateral"
  side
  otherside = coinAccount otherside
  amount = quantity
  instrumentId = coinInstrumentId
  meta = emptyMetadata

coinAllocationSpec : Party -> Party -> Bool -> Token.TransferLegSide -> Time -> Token.AllocationSpecification
coinAllocationSpec coinAdmin authorizer committed leg maturity = Token.AllocationSpecification with
  admin = coinAdmin
  authorizer = coinAccount authorizer
  transferLegSides = [leg]
  settlementDeadline = Some (coinSettlementDeadline maturity)
  nextIterationFunding = None
  committed
  meta = emptyMetadata

allocateCoin : ContractId Instr.AllocationFactory -> Party -> Token.SettlementInfo -> Token.AllocationSpecification -> [ContractId Holding.Holding] -> ExtraArgs -> Update (ContractId Token.Allocation)
allocateCoin factoryCid coinAdmin settlement spec inputHoldingCids extraArgs = do
  factory <- fetch factoryCid
  assertMsg "allocation factory admin must be the Canton Coin admin" ((view factory).admin == coinAdmin)
  now <- getTime
  result <- exercise factoryCid Instr.AllocationFactory_Allocate with
    settlement
    allocation = spec
    requestedAt = now
    inputHoldingCids
    extraArgs
    actors = [fromSomeNote "allocation authorizer" spec.authorizer.owner]
  case result.output of
    Instr.AllocationInstructionResult_Completed allocationCid -> pure allocationCid
    _ -> abort "Canton Coin allocation did not complete in one step"
  where
    fromSomeNote _ (Some p) = p
    fromSomeNote note None = error ("missing " <> note)

-- | Offer secured by Canton Coin; mirrors LoanOffer, with the lock created on
-- acceptance.
template CoinLoanOffer
  with
    issuer : Party
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    valuationStreamId : ContractId ValuationStream
    coinAdmin : Party
    principal : Decimal
    interest : Decimal
    collateralQuantity : Decimal
    maturity : Time
    liquidationThresholdLtv : Decimal
    marginCallWindowSeconds : Int
    settlementRef : Text
  where
    signatory issuer, lender
    observer borrower, regulator

    ensure principal > 0.0 && interest >= 0.0 && collateralQuantity > 0.0
      && liquidationThresholdLtv > 0.0 && liquidationThresholdLtv <= 100.0
      && marginCallWindowSeconds >= 60 && marginCallWindowSeconds <= 86400
      && lender /= borrower && settlementRef /= ""
      && valuationAgent /= lender && valuationAgent /= borrower && valuationAgent /= regulator
      && issuer /= lender && issuer /= borrower && issuer /= regulator && issuer /= valuationAgent
      && coinAdmin /= lender && coinAdmin /= borrower

    -- | In one transaction: lock the borrower's Canton Coin in a committed
    -- allocation executed only by the lender, recheck LTV on a fresh CC mark,
    -- deliver the principal, and open the loan.
    choice AcceptCoin : ContractId CoinLoan
      with
        valuationCid : ContractId CollateralValuation
        allocationFactoryCid : ContractId Instr.AllocationFactory
        inputHoldingCids : [ContractId Holding.Holding]
        extraArgs : ExtraArgs
      controller borrower
      do
        now <- getTime
        assertMsg "cannot accept an offer at or after maturity" (now < maturity)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator coinAsset valuationStreamId valuationCid
        assertMsg "acceptance LTV must be below the liquidation threshold"
          ((principal / (collateralQuantity * unitPrice)) * 100.0 < liquidationThresholdLtv)
        allocationCid <- allocateCoin allocationFactoryCid coinAdmin (coinSettlement lender settlementRef)
          (coinAllocationSpec coinAdmin borrower True (coinCollateralLeg Token.SenderSide lender collateralQuantity) maturity)
          inputHoldingCids extraArgs
        _ <- create CashHolding with issuer; owner = borrower; amount = principal
        create CoinLoan with
          issuer; lender; borrower; regulator; valuationAgent; valuationStreamId; coinAdmin
          principal; interest; collateralQuantity; maturity; liquidationThresholdLtv
          marginCallWindowSeconds; settlementRef; allocationCid
          marginCall = None
          amountRepaid = None

    choice WithdrawCoinOffer : ContractId CashHolding
      controller lender
      do
        create CashHolding with issuer; owner = lender; amount = principal

-- | Open loan whose collateral is a committed Canton Coin allocation.
template CoinLoan
  with
    issuer : Party
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    valuationStreamId : ContractId ValuationStream
    coinAdmin : Party
    principal : Decimal
    interest : Decimal
    collateralQuantity : Decimal
    maturity : Time
    liquidationThresholdLtv : Decimal
    marginCallWindowSeconds : Int
    settlementRef : Text
    allocationCid : ContractId Token.Allocation
    marginCall : Optional MarginCallDetails
    amountRepaid : Optional Decimal
  where
    signatory issuer, lender, borrower
    observer regulator

    ensure principal > 0.0 && interest >= 0.0 && collateralQuantity > 0.0
      && liquidationThresholdLtv > 0.0 && liquidationThresholdLtv <= 100.0
      && lender /= borrower && settlementRef /= ""
      && repaidTotal amountRepaid >= 0.0 && repaidTotal amountRepaid < principal + interest

    choice IssueCoinMarginCall : ContractId CoinLoan
      with
        valuationCid : ContractId CollateralValuation
      controller lender
      do
        now <- getTime
        assertMsg "cannot issue a margin call at or after maturity" (now < maturity)
        assertMsg "a margin call is already open" (marginCall == None)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator coinAsset valuationStreamId valuationCid
        assertMsg "margin call requires an LTV breach"
          ((outstandingPrincipal principal interest amountRepaid / (collateralQuantity * unitPrice)) * 100.0 >= liquidationThresholdLtv)
        let call = MarginCallDetails with
              issuedAt = now
              deadline = addRelTime now (seconds marginCallWindowSeconds)
              unitPrice
        create this with marginCall = Some call

    choice ResolveCoinMarginCall : ContractId CoinLoan
      with
        valuationCid : ContractId CollateralValuation
      controller borrower
      do
        now <- getTime
        assertMsg "cannot resolve a margin call at or after maturity" (now < maturity)
        assertMsg "no margin call is open" (marginCall /= None)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator coinAsset valuationStreamId valuationCid
        assertMsg "collateral remains below the required value"
          ((outstandingPrincipal principal interest amountRepaid / (collateralQuantity * unitPrice)) * 100.0 < liquidationThresholdLtv)
        create this with marginCall = None

    choice PartialRepayCoin : ContractId CoinLoan
      with
        paymentCid : ContractId CashHolding
        valuationCid : Optional (ContractId CollateralValuation)
      controller borrower
      do
        now <- getTime
        assertMsg "cannot pay down at or after maturity" (now < maturity)
        cash <- fetch paymentCid
        assertMsg "payment issuer mismatch" (cash.issuer == issuer)
        assertMsg "payment cash must be owned by the borrower" (cash.owner == borrower)
        let paid = repaidTotal amountRepaid + cash.amount
        assertMsg "a partial payment must be less than the outstanding balance; use Repay to settle"
          (paid < principal + interest)
        cured <- case marginCall of
          None -> pure False
          Some _ -> do
            markCid <- case valuationCid of
              None -> abort "a fresh valuation is required to pay down during a margin call"
              Some markCid -> pure markCid
            unitPrice <- checkedPrice valuationAgent lender borrower regulator coinAsset valuationStreamId markCid
            assertMsg "payment must restore LTV below the threshold while a margin call is open"
              ((outstandingPrincipal principal interest (Some paid) / (collateralQuantity * unitPrice)) * 100.0 < liquidationThresholdLtv)
            pure True
        archive paymentCid
        _ <- create CashHolding with issuer; owner = lender; amount = cash.amount
        create this with
          amountRepaid = Some paid
          marginCall = if cured then None else marginCall

    -- | Settle the outstanding balance in cash; the lender's authority, carried
    -- by this contract, cancels the allocation and the Canton Coin unlocks.
    choice RepayCoin : ContractId LoanClosed
      with
        repaymentCid : ContractId CashHolding
        cancelExtraArgs : ExtraArgs
      controller borrower
      do
        let repayment = principal + interest - repaidTotal amountRepaid
        cash <- fetch repaymentCid
        assertMsg "repayment issuer mismatch" (cash.issuer == issuer)
        assertMsg "repayment cash must be owned by the borrower" (cash.owner == borrower)
        assertMsg "repayment amount mismatch" (cash.amount == repayment)
        archive repaymentCid
        _ <- create CashHolding with issuer; owner = lender; amount = repayment
        releaseCoin allocationCid lender cancelExtraArgs
        closeCoinLoan this "Repaid" True (Some (principal + interest))

    -- | Lender prepares the receiving side of a liquidation: an uncommitted
    -- allocation that credits the lender when the batch settles.
    nonconsuming choice PrepareCoinReceipt : ContractId Token.Allocation
      with
        allocationFactoryCid : ContractId Instr.AllocationFactory
        extraArgs : ExtraArgs
      controller lender
      do
        allocateCoin allocationFactoryCid coinAdmin (coinSettlement lender settlementRef)
          (coinAllocationSpec coinAdmin lender False (coinCollateralLeg Token.ReceiverSide borrower collateralQuantity) maturity)
          [] extraArgs

    -- | After an expired call, on a fresh mark that still breaches, the locked
    -- Canton Coin settles to the lender.
    choice LiquidateCoin : ContractId LoanClosed
      with
        valuationCid : ContractId CollateralValuation
        settlementFactoryCid : ContractId Token.SettlementFactory
        receiptAllocationCid : ContractId Token.Allocation
        extraArgs : ExtraArgs
      controller lender
      do
        call <- case marginCall of
          None -> abort "liquidation requires an open margin call"
          Some call -> pure call
        now <- getTime
        assertMsg "margin call deadline has not passed" (now >= call.deadline)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator coinAsset valuationStreamId valuationCid
        assertMsg "liquidation requires an LTV breach"
          ((outstandingPrincipal principal interest amountRepaid / (collateralQuantity * unitPrice)) * 100.0 >= liquidationThresholdLtv)
        settleCoin this settlementFactoryCid receiptAllocationCid extraArgs
        closeCoinLoan this "Liquidated" False amountRepaid

    choice LiquidateCoinOverdue : ContractId LoanClosed
      with
        settlementFactoryCid : ContractId Token.SettlementFactory
        receiptAllocationCid : ContractId Token.Allocation
        extraArgs : ExtraArgs
      controller lender
      do
        now <- getTime
        assertMsg "loan is not past maturity" (now > maturity)
        settleCoin this settlementFactoryCid receiptAllocationCid extraArgs
        closeCoinLoan this "LiquidatedAtMaturity" False amountRepaid

    -- | The lender forgives the loan and releases the Canton Coin. Also used by
    -- the demo reset so no borrower funds stay locked.
    choice WriteOffCoin : ContractId LoanClosed
      with
        cancelExtraArgs : ExtraArgs
      controller lender
      do
        releaseCoin allocationCid lender cancelExtraArgs
        closeCoinLoan this "WrittenOff" True amountRepaid

releaseCoin : ContractId Token.Allocation -> Party -> ExtraArgs -> Update ()
releaseCoin allocationCid lender extraArgs = do
  result <- exercise allocationCid Token.Allocation_Cancel with
    actors = [lender]
    extraArgs
  case result.output of
    Token.AllocationResult_Cancelled -> pure ()
    _ -> abort "collateral allocation was not cancelled"

settleCoin : CoinLoan -> ContractId Token.SettlementFactory -> ContractId Token.Allocation -> ExtraArgs -> Update ()
settleCoin loan settlementFactoryCid receiptAllocationCid extraArgs = do
  factory <- fetch settlementFactoryCid
  assertMsg "settlement factory admin must be the Canton Coin admin" ((view factory).admin == loan.coinAdmin)
  receipt <- fetch receiptAllocationCid
  let receiptView = view receipt
  assertMsg "receipt allocation must belong to the lender and this loan"
    (receiptView.allocation.authorizer == coinAccount loan.lender
      && receiptView.settlement.id == loan.settlementRef
      && receiptView.allocation.transferLegSides == [coinCollateralLeg Token.ReceiverSide loan.borrower loan.collateralQuantity])
  result <- exercise settlementFactoryCid Token.SettlementFactory_SettleBatch with
    settlement = coinSettlement loan.lender loan.settlementRef
    transferLegs =
      [ Token.TransferLeg with
          transferLegId = "collateral"
          sender = coinAccount loan.borrower
          receiver = coinAccount loan.lender
          amount = loan.collateralQuantity
          instrumentId = coinInstrumentId
          meta = emptyMetadata
      ]
    allocations =
      [ Token.FinalizedAllocation with allocationCid = loan.allocationCid; extraTransferLegSides = []; nextIterationFunding = None
      , Token.FinalizedAllocation with allocationCid = receiptAllocationCid; extraTransferLegSides = []; nextIterationFunding = None
      ]
    actors = [loan.lender]
    extraArgs
  let settled r = case r.output of
        Token.AllocationResult_Settled _ -> True
        _ -> False
  assertMsg "collateral settlement did not settle" (all settled result.allocationSettleResults)

closeCoinLoan : CoinLoan -> Text -> Bool -> Optional Decimal -> Update (ContractId LoanClosed)
closeCoinLoan loan reason collateralReleased amountRepaid =
  create LoanClosed with
    issuer = loan.issuer
    lender = loan.lender
    borrower = loan.borrower
    regulator = loan.regulator
    valuationAgent = loan.valuationAgent
    valuationStreamId = loan.valuationStreamId
    principal = loan.principal
    interest = loan.interest
    collateralAsset = coinAsset
    collateralQuantity = loan.collateralQuantity
    maturity = loan.maturity
    reason
    collateralReleased
    amountRepaid
