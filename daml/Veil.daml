module Veil where

import DA.Foldable (forA_)
import DA.Numeric (cast, mul)
import DA.Optional (fromOptional)
import DA.Time (RelTime, addRelTime, days, hours, seconds)
import Splice.Api.Token.AllocationInstructionV2 qualified as Instr
import Splice.Api.Token.AllocationV2 qualified as Token
import Splice.Api.Token.HoldingV2 qualified as Holding
import Splice.Api.Token.MetadataV1 (AnyContractId, ExtraArgs, emptyMetadata)

data MarginCallDetails = MarginCallDetails
  with
    issuedAt : Time
    deadline : Time
    unitPrice : Decimal
  deriving (Eq, Show)

-- The counterparties authorize one price stream. Descendant prices retain
-- their signatures, so the valuer alone cannot fabricate a parallel branch.
template ValuationStream
  with
    valuationAgent : Party
    lender : Party
    borrower : Party
    regulator : Party
    collateralAsset : Text
  where
    signatory valuationAgent, lender, borrower
    observer regulator
    ensure collateralAsset /= "" && lender /= borrower
      && valuationAgent /= lender && valuationAgent /= borrower && valuationAgent /= regulator

    choice PublishInitial : ContractId CollateralValuation
      with
        unitPrice : Decimal
      controller valuationAgent
      do
        observedAt <- getTime
        create CollateralValuation with
          valuationAgent; lender; borrower; regulator; collateralAsset
          streamId = self
          unitPrice; observedAt

-- A current price is replaced, never appended. The archived predecessor can
-- no longer be fetched even inside the five-minute freshness window.
template CollateralValuation
  with
    valuationAgent : Party
    lender : Party
    borrower : Party
    regulator : Party
    collateralAsset : Text
    streamId : ContractId ValuationStream
    unitPrice : Decimal
    observedAt : Time
  where
    signatory valuationAgent, lender, borrower
    observer regulator
    ensure unitPrice > 0.0 && collateralAsset /= ""

    choice Publish : ContractId CollateralValuation
      with
        unitPrice : Decimal
      controller valuationAgent
      do
        observedAt <- getTime
        create this with unitPrice; observedAt

-- Check every use, including liquidation after a grace period. A mark must
-- identify this deal's counterparties and asset and be no more than 5 min old.
checkedPrice : Party -> Party -> Party -> Party -> Text -> ContractId ValuationStream -> ContractId CollateralValuation -> Update Decimal
checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid = do
  mark <- fetch valuationCid
  now <- getTime
  assertMsg "valuation agent mismatch" (mark.valuationAgent == valuationAgent)
  assertMsg "valuation counterparties mismatch"
    (mark.lender == lender && mark.borrower == borrower && mark.regulator == regulator)
  assertMsg "valuation asset mismatch" (mark.collateralAsset == collateralAsset)
  assertMsg "valuation stream mismatch" (mark.streamId == valuationStreamId)
  assertMsg "valuation cannot be from the future" (mark.observedAt <= now)
  assertMsg "valuation is stale" (now <= addRelTime mark.observedAt (seconds 300))
  pure mark.unitPrice

-- Partial payments settle the fixed interest first, then principal. The
-- agreed terms stay on the contract; only the running total changes.
repaidTotal : Optional Decimal -> Decimal
repaidTotal = fromOptional 0.0

outstandingPrincipal : Decimal -> Decimal -> Optional Decimal -> Decimal
outstandingPrincipal principal interest amountRepaid = principal - max 0.0 (repaidTotal amountRepaid - interest)

-- LTV % = owed / (quantity × price) × 100, compared by cross-multiplying
-- (0.10.0). A collateral value that rounds to zero now reads as an unbounded
-- LTV instead of aborting the choice with a division by zero.
ltvBelow : Decimal -> Decimal -> Decimal -> Decimal -> Bool
ltvBelow thresholdLtv owed quantity unitPrice = owed * 100.0 < thresholdLtv * (quantity * unitPrice)

ltvAtOrAbove : Decimal -> Decimal -> Decimal -> Decimal -> Bool
ltvAtOrAbove thresholdLtv owed quantity unitPrice = not (ltvBelow thresholdLtv owed quantity unitPrice)

-- The demo issuer authorizes issuance. Spending choices carry that authority
-- forward without giving the owner permission to create arbitrary holdings.
template CashHolding
  with
    issuer : Party
    owner : Party
    amount : Decimal
  where
    signatory issuer, owner
    ensure amount > 0.0 && issuer /= owner

    -- | Lender funds a borrower-specific offer directly from cash. The funded
    -- principal leaves the lender here and is delivered to the borrower on
    -- Accept (or refunded on Withdraw). The issuer-signed offer is the escrow:
    -- its consuming choices can release this reserved principal only once.
    choice MakeOffer : ContractId LoanOffer
      with
        borrower : Party
        regulator : Party
        valuationAgent : Party
        valuationCid : ContractId CollateralValuation
        principal : Decimal
        interest : Decimal
        collateralAsset : Text
        collateralQuantity : Decimal
        maturity : Time
        liquidationThresholdLtv : Decimal
        marginCallWindowSeconds : Int
        expiresAt : Optional Time
      controller owner
      do
        validateOfferTerms owner borrower regulator principal interest collateralQuantity maturity expiresAt
        mark <- fetch valuationCid
        unitPrice <- checkedPrice valuationAgent owner borrower regulator collateralAsset mark.streamId valuationCid
        assertMsg "offer LTV must be below the liquidation threshold"
          (ltvBelow liquidationThresholdLtv principal collateralQuantity unitPrice)
        assertMsg "insufficient cash to fund offer" (amount >= principal)
        if amount > principal
          then do
            _ <- create CashHolding with issuer; owner; amount = amount - principal
            pure ()
          else pure ()
        create LoanOffer with
          issuer
          lender = owner
          borrower
          regulator
          valuationAgent
          valuationStreamId = mark.streamId
          principal
          interest
          collateralAsset
          collateralQuantity
          maturity
          liquidationThresholdLtv
          marginCallWindowSeconds
          expiresAt

    choice Split : (ContractId CashHolding, ContractId CashHolding)
      with
        splitAmount : Decimal
      controller owner
      do
        assertMsg "split amount must be positive and less than total amount" (splitAmount > 0.0 && splitAmount < amount)
        let remainingAmount = amount - splitAmount
        cid1 <- create CashHolding with issuer; owner; amount = splitAmount
        cid2 <- create CashHolding with issuer; owner; amount = remainingAmount
        pure (cid1, cid2)

-- Demo collateral uses the same controlled issuer. It is simulated inventory,
-- not a claim that Treasury/MMF units are actually held by a custodian.
template CollateralHolding
  with
    issuer : Party
    owner : Party
    asset : Text
    quantity : Decimal
  where
    signatory issuer, owner
    ensure quantity > 0.0 && asset /= "" && issuer /= owner

    -- Escrow a replacement holding for an open loan. The lender can see the
    -- request (and so approve it) without ever fetching the borrower's wallet.
    choice ProposeSubstitution : ContractId SubstitutionRequest
      with
        lender : Party
        regulator : Party
        valuationAgent : Party
        releaseAsset : Text
        releaseQuantity : Decimal
        newValuationStreamId : ContractId ValuationStream
      controller owner
      do
        create SubstitutionRequest with
          issuer; lender; borrower = owner; regulator; valuationAgent
          releaseAsset; releaseQuantity
          newAsset = asset; newQuantity = quantity; newValuationStreamId

    -- Carve out the intended deposit privately before a Loan choice fetches it.
    choice SplitCollateral : (ContractId CollateralHolding, ContractId CollateralHolding)
      with
        splitQuantity : Decimal
      controller owner
      do
        assertMsg "split quantity must be positive and less than total quantity"
          (splitQuantity > 0.0 && splitQuantity < quantity)
        exact <- create CollateralHolding with issuer; owner; asset; quantity = splitQuantity
        remainder <- create CollateralHolding with issuer; owner; asset; quantity = quantity - splitQuantity
        pure (exact, remainder)

-- | Borrower's request to swap an open loan's collateral for another asset.
--
-- The replacement is held here in escrow, with the issuer's signature carried
-- from the consumed holding. The request names the collateral it expects to
-- release, so a top-up or an earlier substitution invalidates it. The lender
-- applies it through Loan.ApplySubstitution or rejects it; either side's exit
-- returns the escrowed holding exactly once.
template SubstitutionRequest
  with
    issuer : Party
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    releaseAsset : Text
    releaseQuantity : Decimal
    newAsset : Text
    newQuantity : Decimal
    newValuationStreamId : ContractId ValuationStream
  where
    signatory issuer, borrower
    observer lender, regulator

    ensure newQuantity > 0.0 && releaseQuantity > 0.0 && newAsset /= "" && releaseAsset /= ""
      && newAsset /= releaseAsset && lender /= borrower && issuer /= borrower && issuer /= lender

    choice RejectSubstitution : ContractId CollateralHolding
      controller lender
      do
        create CollateralHolding with issuer; owner = borrower; asset = newAsset; quantity = newQuantity

    choice CancelSubstitution : ContractId CollateralHolding
      controller borrower
      do
        create CollateralHolding with issuer; owner = borrower; asset = newAsset; quantity = newQuantity

-- | Borrower-specific loan offer for a known-counterparty lending flow.
--
-- The lender commits the terms; the issuer's signature carries the reserved
-- principal from CashHolding.MakeOffer. A lender cannot construct trusted
-- escrow directly. The trusted issuer can authorize issuance by definition.
template LoanOffer
  with
    issuer : Party
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    valuationStreamId : ContractId ValuationStream
    principal : Decimal
    interest : Decimal
    collateralAsset : Text
    collateralQuantity : Decimal
    maturity : Time
    liquidationThresholdLtv : Decimal
    marginCallWindowSeconds : Int
    -- Appended in 0.9.0; None on offers created by earlier versions.
    expiresAt : Optional Time
  where
    signatory issuer, lender
    observer borrower, regulator

    ensure principal > 0.0 && interest >= 0.0 && collateralQuantity > 0.0
      && liquidationThresholdLtv > 0.0 && liquidationThresholdLtv <= 100.0
      && marginCallWindowSeconds >= 60 && marginCallWindowSeconds <= 86400
      && lender /= borrower && collateralAsset /= ""
      && valuationAgent /= lender && valuationAgent /= borrower && valuationAgent /= regulator
      && issuer /= lender && issuer /= borrower && issuer /= regulator && issuer /= valuationAgent

    -- | Borrower locks matching collateral and draws the principal. The
    -- borrower's CollateralHolding is consumed (encumbered in the loan) and a
    -- CashHolding for the principal is delivered to the borrower.
    choice Accept : ContractId Loan
      with
        collateralCid : ContractId CollateralHolding
        valuationCid : ContractId CollateralValuation
      controller borrower
      do
        assertOfferLive maturity expiresAt
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        assertMsg "acceptance LTV must be below the liquidation threshold"
          (ltvBelow liquidationThresholdLtv principal collateralQuantity unitPrice)
        collateral <- fetch collateralCid
        assertMsg "collateral issuer mismatch" (collateral.issuer == issuer)
        assertMsg "collateral must be owned by the borrower" (collateral.owner == borrower)
        assertMsg "collateral asset mismatch" (collateral.asset == collateralAsset)
        assertMsg "collateral quantity mismatch" (collateral.quantity == collateralQuantity)
        archive collateralCid
        _ <- create CashHolding with issuer; owner = borrower; amount = principal
        create Loan with
          issuer
          lender
          borrower
          regulator
          valuationAgent
          valuationStreamId
          principal
          interest
          collateralAsset
          collateralQuantity
          maturity
          liquidationThresholdLtv
          marginCallWindowSeconds
          marginCall = None
          collateralLocked = True
          amountRepaid = None

    -- | Lender withdraws the unaccepted offer; the pre-funded principal is
    -- refunded to the lender.
    choice Withdraw : ContractId CashHolding
      controller lender
      do
        create CashHolding with issuer; owner = lender; amount = principal

    -- | Borrower declines the offer, before or after expiry; the escrowed
    -- principal goes back to the lender exactly as on Withdraw.
    choice RejectOffer : ContractId CashHolding
      controller borrower
      do
        create CashHolding with issuer; owner = lender; amount = principal

-- | Active private bilateral loan created after the borrower accepts an offer.
--
-- The issuer carries the locked collateral's authority through the lifecycle.
-- Lender and borrower authorize their shared obligation; regulator observes.
template Loan
  with
    issuer : Party
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    valuationStreamId : ContractId ValuationStream
    principal : Decimal
    interest : Decimal
    collateralAsset : Text
    collateralQuantity : Decimal
    maturity : Time
    liquidationThresholdLtv : Decimal
    marginCallWindowSeconds : Int
    marginCall : Optional MarginCallDetails
    collateralLocked : Bool
    amountRepaid : Optional Decimal
  where
    signatory issuer, lender, borrower
    observer regulator

    ensure principal > 0.0 && interest >= 0.0 && collateralQuantity > 0.0
      && liquidationThresholdLtv > 0.0 && liquidationThresholdLtv <= 100.0
      && marginCallWindowSeconds >= 60 && marginCallWindowSeconds <= 86400
      && lender /= borrower && collateralAsset /= "" && collateralLocked
      && repaidTotal amountRepaid >= 0.0 && repaidTotal amountRepaid < principal + interest
      && valuationAgent /= lender && valuationAgent /= borrower && valuationAgent /= regulator
      && issuer /= lender && issuer /= borrower && issuer /= regulator && issuer /= valuationAgent

    -- Consuming the Loan prevents a parallel call or a reset of its deadline.
    choice IssueMarginCall : ContractId Loan
      with
        valuationCid : ContractId CollateralValuation
      controller lender
      do
        now <- getTime
        assertMsg "cannot issue a margin call at or after maturity" (now < maturity)
        assertMsg "a margin call is already open" (marginCall == None)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        assertMsg "margin call requires an LTV breach"
          (ltvAtOrAbove liquidationThresholdLtv (outstandingPrincipal principal interest amountRepaid) collateralQuantity unitPrice)
        let call = MarginCallDetails with
              issuedAt = now
              deadline = addRelTime now (seconds marginCallWindowSeconds)
              unitPrice
        create this with marginCall = Some call

    choice TopUpCollateral : ContractId Loan
      with
        collateralCid : ContractId CollateralHolding
        topUpQuantity : Decimal
        valuationCid : ContractId CollateralValuation
      controller borrower
      do
        call <- case marginCall of
          None -> abort "no margin call is open"
          Some call -> pure call
        now <- getTime
        assertMsg "cannot top up at or after maturity" (now < maturity)
        assertMsg "margin call deadline has passed" (now < call.deadline)
        assertMsg "top-up quantity must be positive" (topUpQuantity > 0.0)
        collateral <- fetch collateralCid
        assertMsg "top-up issuer mismatch" (collateral.issuer == issuer)
        assertMsg "top-up must be owned by the borrower" (collateral.owner == borrower)
        assertMsg "top-up asset mismatch" (collateral.asset == collateralAsset)
        assertMsg "top-up must use an exact holding; split privately first" (collateral.quantity == topUpQuantity)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        let totalQuantity = collateralQuantity + topUpQuantity
        assertMsg "top-up must restore LTV below the threshold"
          (ltvBelow liquidationThresholdLtv (outstandingPrincipal principal interest amountRepaid) totalQuantity unitPrice)
        archive collateralCid
        create this with collateralQuantity = totalQuantity; marginCall = None

    -- A recovered price can cure the call without an unnecessary deposit.
    choice ResolveMarginCall : ContractId Loan
      with
        valuationCid : ContractId CollateralValuation
      controller borrower
      do
        now <- getTime
        assertMsg "cannot resolve a margin call at or after maturity" (now < maturity)
        assertMsg "no margin call is open" (marginCall /= None)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        assertMsg "collateral remains below the required value"
          (ltvBelow liquidationThresholdLtv (outstandingPrincipal principal interest amountRepaid) collateralQuantity unitPrice)
        create this with marginCall = None

    -- | Lender approves a collateral substitution. In one transaction the
    -- escrowed replacement becomes the locked collateral, the loan is rebound to
    -- the replacement asset's jointly authorized price stream, and the released
    -- collateral returns to the borrower. Coverage is re-checked on a fresh mark
    -- of the new asset; the substitution cannot cure or bypass an open call.
    choice ApplySubstitution : ContractId Loan
      with
        requestCid : ContractId SubstitutionRequest
        newValuationCid : ContractId CollateralValuation
      controller lender
      do
        now <- getTime
        assertMsg "cannot substitute at or after maturity" (now < maturity)
        assertMsg "cannot substitute while a margin call is open" (marginCall == None)
        request <- fetch requestCid
        assertMsg "substitution parties mismatch"
          (request.issuer == issuer && request.lender == lender && request.borrower == borrower
            && request.regulator == regulator && request.valuationAgent == valuationAgent)
        assertMsg "substitution no longer matches the locked collateral"
          (request.releaseAsset == collateralAsset && request.releaseQuantity == collateralQuantity)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator request.newAsset request.newValuationStreamId newValuationCid
        assertMsg "substituted collateral must keep LTV below the threshold"
          (ltvBelow liquidationThresholdLtv (outstandingPrincipal principal interest amountRepaid) request.newQuantity unitPrice)
        archive requestCid
        _ <- create CollateralHolding with issuer; owner = borrower; asset = collateralAsset; quantity = collateralQuantity
        create this with
          collateralAsset = request.newAsset
          collateralQuantity = request.newQuantity
          valuationStreamId = request.newValuationStreamId

    -- | Borrower pays part of the balance with an exact cash holding. With a
    -- margin call open, the payment must cure it on a fresh mark; otherwise it
    -- simply reduces what is owed. Full settlement stays with Repay, which is
    -- the only choice that releases collateral.
    choice PartialRepay : ContractId Loan
      with
        paymentCid : ContractId CashHolding
        valuationCid : Optional (ContractId CollateralValuation)
      controller borrower
      do
        now <- getTime
        assertMsg "cannot pay down at or after maturity" (now < maturity)
        cash <- fetch paymentCid
        assertMsg "payment issuer mismatch" (cash.issuer == issuer)
        assertMsg "payment cash must be owned by the borrower" (cash.owner == borrower)
        let paid = repaidTotal amountRepaid + cash.amount
        assertMsg "a partial payment must be less than the outstanding balance; use Repay to settle"
          (paid < principal + interest)
        let remainingPrincipal = outstandingPrincipal principal interest (Some paid)
        cured <- case marginCall of
          None -> pure False
          Some _ -> do
            markCid <- case valuationCid of
              None -> abort "a fresh valuation is required to pay down during a margin call"
              Some markCid -> pure markCid
            unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId markCid
            assertMsg "payment must restore LTV below the threshold while a margin call is open"
              (ltvBelow liquidationThresholdLtv remainingPrincipal collateralQuantity unitPrice)
            pure True
        archive paymentCid
        _ <- create CashHolding with issuer; owner = lender; amount = cash.amount
        create this with
          amountRepaid = Some paid
          marginCall = if cured then None else marginCall

    -- | Borrower repays principal + interest in cash and gets collateral back.
    -- Split privately first: only the exact payment is disclosed to this loan.
    choice Repay : ContractId LoanClosed
      with
        repaymentCid : ContractId CashHolding
      controller borrower
      do
        let repayment = principal + interest - repaidTotal amountRepaid
        cash <- fetch repaymentCid
        assertMsg "repayment issuer mismatch" (cash.issuer == issuer)
        assertMsg "repayment cash must be owned by the borrower" (cash.owner == borrower)
        assertMsg "repayment amount mismatch" (cash.amount == repayment)
        archive repaymentCid
        _ <- create CashHolding with issuer; owner = lender; amount = repayment
        _ <- create CollateralHolding with issuer; owner = borrower; asset = collateralAsset; quantity = collateralQuantity
        now <- getTime
        create LoanClosed with
          issuer
          lender
          borrower
          regulator
          valuationAgent
          valuationStreamId
          principal
          interest
          collateralAsset
          collateralQuantity
          maturity
          reason = "Repaid"
          collateralReleased = True
          amountRepaid = Some (principal + interest)
          closedAt = Some now
          liquidationUnitPrice = None
          collateralSeized = None
          collateralReturned = Some collateralQuantity

    -- | A call must have expired and a fresh attested mark must still show a
    -- breach. There is no lender-supplied price or grace-period bypass. The
    -- lender receives only the units covering the outstanding balance at that
    -- mark; any surplus returns to the borrower.
    choice Liquidate : ContractId LoanClosed
      with
        valuationCid : ContractId CollateralValuation
      controller lender
      do
        call <- case marginCall of
          None -> abort "liquidation requires an open margin call"
          Some call -> pure call
        now <- getTime
        assertMsg "margin call deadline has not passed" (now >= call.deadline)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId valuationCid
        assertMsg "liquidation requires an LTV breach"
          (ltvAtOrAbove liquidationThresholdLtv (outstandingPrincipal principal interest amountRepaid) collateralQuantity unitPrice)
        closeOut this "Liquidated" unitPrice

    -- Repayment default is distinct from a price breach. Repayment can still
    -- win the race; either consuming choice closes the loan exactly once.
    -- Default close-out nets at a fresh attested mark, exactly like a margin
    -- liquidation: the argument is Optional only for upgrade compatibility.
    choice LiquidateOverdue : ContractId LoanClosed
      with
        valuationCid : Optional (ContractId CollateralValuation)
      controller lender
      do
        now <- getTime
        assertMsg "loan is not past maturity" (now > maturity)
        markCid <- case valuationCid of
          None -> abort "overdue liquidation requires a fresh valuation to return any surplus"
          Some markCid -> pure markCid
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralAsset valuationStreamId markCid
        closeOut this "LiquidatedAtMaturity" unitPrice

-- | Terminal settlement record created when a loan closes, either through
-- borrower repayment or lender liquidation.
--
-- The issuer and counterparties retain a shared settlement record. The
-- regulator keeps observer visibility, while an outsider still sees nothing.
template LoanClosed
  with
    issuer : Party
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    valuationStreamId : ContractId ValuationStream
    principal : Decimal
    interest : Decimal
    collateralAsset : Text
    collateralQuantity : Decimal
    maturity : Time
    reason : Text
    collateralReleased : Bool
    amountRepaid : Optional Decimal
    -- Appended in 0.9.0 so a close can be audited afterwards; None on records
    -- created by earlier versions.
    closedAt : Optional Time
    liquidationUnitPrice : Optional Decimal
    collateralSeized : Optional Decimal
    collateralReturned : Optional Decimal
  where
    signatory issuer, lender, borrower
    observer regulator

    ensure principal > 0.0 && interest >= 0.0 && collateralQuantity > 0.0
      && collateralAsset /= "" && lender /= borrower
      && issuer /= lender && issuer /= borrower && issuer /= regulator && issuer /= valuationAgent

    -- | Archive the shared settlement record. Both counterparties must agree,
    -- so neither can erase the other's proof of settlement alone. The demo
    -- reset submits with issuer, lender and borrower authority.
    choice Dismiss : ()
      controller lender, borrower
      do
        pure ()

-- | Settle a T-Bill loan by close-out netting at an attested unit price.
closeOut : Loan -> Text -> Decimal -> Update (ContractId LoanClosed)
closeOut loan reason unitPrice = do
  now <- getTime
  let owed = loan.principal + loan.interest - repaidTotal loan.amountRepaid
      seized = seizedQuantity loan.collateralQuantity owed unitPrice
      returned = loan.collateralQuantity - seized
  _ <- create CollateralHolding with
    issuer = loan.issuer; owner = loan.lender; asset = loan.collateralAsset; quantity = seized
  if returned > 0.0
    then do
      _ <- create CollateralHolding with
        issuer = loan.issuer; owner = loan.borrower; asset = loan.collateralAsset; quantity = returned
      pure ()
    else pure ()
  create LoanClosed with
    issuer = loan.issuer
    lender = loan.lender
    borrower = loan.borrower
    regulator = loan.regulator
    valuationAgent = loan.valuationAgent
    valuationStreamId = loan.valuationStreamId
    principal = loan.principal
    interest = loan.interest
    collateralAsset = loan.collateralAsset
    collateralQuantity = loan.collateralQuantity
    maturity = loan.maturity
    reason
    collateralReleased = False
    amountRepaid = loan.amountRepaid
    closedAt = Some now
    liquidationUnitPrice = Some unitPrice
    collateralSeized = Some seized
    collateralReturned = Some returned

-- ---------------------------------------------------------------------------
-- Token Standard loans (CIP-112 Token Standard V2)
--
-- Principal and collateral are both registry instruments, for example USDCx
-- lent against CBTC or Canton Coin. Every asset movement is a registry
-- allocation executed by lender and borrower together, and each settles in a
-- delivery-versus-payment batch inside a Veil choice:
--
--   * the lender funds an offer with a committed principal allocation, which
--     cannot be withdrawn before the offer expires (the lender can still
--     archive the offer itself, which stops acceptance);
--   * acceptance locks the borrower's collateral in a committed allocation and
--     settles the principal to the borrower in the same transaction;
--   * every payment settles borrower -> lender in its own batch; full
--     repayment also cancels the collateral lock;
--   * liquidation settles the whole collateral lock to the lender.
--
-- Both counterparties are signatories of the loan, so its choices carry the
-- executors' joint authority, and neither can settle or cancel an allocation
-- through the registry alone. The registry factories are pinned on the offer
-- and checked against the instrument admin on every use, so the executors'
-- authority only ever reaches factories that both counterparties accepted at
-- origination, or that both later replace together (RegistryChange; see
-- docs/AUDIT-TRIAGE.md, R-1).

-- | A registry instrument: its admin and the instrument id it issues.
data Instrument = Instrument
  with
    admin : Party
    id : Text
  deriving (Eq, Show)

-- | The registry factories for one instrument, as agreed at origination.
data Registry = Registry
  with
    instrument : Instrument
    allocationFactory : ContractId Instr.AllocationFactory
    settlementFactory : ContractId Token.SettlementFactory
  deriving (Eq, Show)

tokenAccount : Party -> Holding.Account
tokenAccount party = Holding.Account with owner = Some party; provider = None; id = ""

-- | Every allocation of a loan is executed by lender and borrower together.
loanExecutors : Party -> Party -> [Party]
loanExecutors lender borrower = [lender, borrower]

-- | Each batch of a loan has its own settlement id: the funding, the
-- collateral lock and every payment. The anchor is the archived request the
-- offer was funded from, so two loans never share a settlement even when a
-- lender reuses a reference.
loanSettlement : Party -> Party -> AnyContractId -> Text -> Token.SettlementInfo
loanSettlement lender borrower anchor settlementId = Token.SettlementInfo with
  executors = loanExecutors lender borrower
  id = settlementId
  cid = Some anchor
  meta = emptyMetadata

fundingRef : Text -> Text
fundingRef ref = ref <> "/funding"

collateralRef : Text -> Text
collateralRef ref = ref <> "/collateral"

paymentRef : Text -> Int -> Text
paymentRef ref n = ref <> "/payment/" <> show n

-- | The lock must outlive maturity so overdue liquidation remains possible; a
-- day after maturity the borrower may withdraw whatever was never settled.
lockDeadline : Time -> Time
lockDeadline maturity = addRelTime maturity (days 1)

-- | A payment is allocated and settled in one transaction; the deadline only
-- bounds an allocation that a failed batch might leave behind.
paymentWindow : RelTime
paymentWindow = hours 1

legSide : Text -> Token.TransferSide -> Party -> Decimal -> Instrument -> Token.TransferLegSide
legSide transferLegId side otherside amount instrument = Token.TransferLegSide with
  transferLegId
  side
  otherside = tokenAccount otherside
  amount
  instrumentId = instrument.id
  meta = emptyMetadata

allocationSpec : Instrument -> Party -> Bool -> Time -> Token.TransferLegSide -> Token.AllocationSpecification
allocationSpec instrument authorizer committed deadline leg = Token.AllocationSpecification with
  admin = instrument.admin
  authorizer = tokenAccount authorizer
  transferLegSides = [leg]
  settlementDeadline = Some deadline
  nextIterationFunding = None
  committed
  meta = emptyMetadata

-- | The sending side of a transfer: committed, so the sender cannot withdraw
-- it before the deadline.
sendSpec : Instrument -> Text -> Party -> Party -> Decimal -> Time -> Token.AllocationSpecification
sendSpec instrument legId sender receiver amount deadline =
  allocationSpec instrument sender True deadline (legSide legId Token.SenderSide receiver amount instrument)

-- | The receiving side of a transfer.
receiveSpec : Instrument -> Text -> Party -> Party -> Decimal -> Time -> Token.AllocationSpecification
receiveSpec instrument legId sender receiver amount deadline =
  allocationSpec instrument receiver False deadline (legSide legId Token.ReceiverSide sender amount instrument)

transferLeg : Instrument -> Text -> Party -> Party -> Decimal -> Token.TransferLeg
transferLeg instrument transferLegId sender receiver amount = Token.TransferLeg with
  transferLegId
  sender = tokenAccount sender
  receiver = tokenAccount receiver
  amount
  instrumentId = instrument.id
  meta = emptyMetadata

-- | Require that an allocation is the registry's own and exactly the one Veil
-- expects. Only the admin's templates carry the admin's signature, so an
-- allocation written by a counterparty fails here before Veil relies on it or
-- hands it the executors' authority. The registry may annotate metadata, so
-- the top-level meta fields are not compared.
checkAllocation : ContractId Token.Allocation -> Instrument -> Token.SettlementInfo -> Token.AllocationSpecification -> Update ()
checkAllocation allocationCid instrument settlement spec = do
  v <- checkSettlement allocationCid instrument settlement
  assertMsg "allocation terms mismatch" ((v.allocation with meta = spec.meta) == spec)
  -- A registry may expire an allocation before its settlement deadline (Amulet
  -- caps it by a TTL), after which the authorizer can take the holdings back
  -- alone. Refuse one that would not last as long as Veil relies on it.
  assertMsg "allocation expires before its settlement deadline"
    (case (spec.settlementDeadline, v.expiresAt) of
      (Some deadline, Some expiry) -> expiry >= deadline
      _ -> True)

-- | The signature and settlement part of checkAllocation, for an allocation
-- whose terms were verified when the loan was opened.
checkSettlement : ContractId Token.Allocation -> Instrument -> Token.SettlementInfo -> Update Token.AllocationView
checkSettlement allocationCid instrument settlement = do
  allocation <- fetch allocationCid
  assertMsg "allocation must be signed by the instrument admin" (instrument.admin `elem` signatory allocation)
  let v = view allocation
  assertMsg "allocation settlement mismatch" ((v.settlement with meta = settlement.meta) == settlement)
  pure v

-- | Allocate through the pinned factory with the authorizer's authority. The
-- factory is disclosed by its admin, its only stakeholder, so it can only be
-- read through the public-fetch choice, whose answer its own code computes.
-- That catches a wrong factory, not a forged one; the allocation it returns
-- is what checkAllocation verifies.
allocate : Registry -> Token.SettlementInfo -> Token.AllocationSpecification -> [ContractId Holding.Holding] -> ExtraArgs -> Update (ContractId Token.Allocation)
allocate registry settlement spec inputHoldingCids extraArgs = do
  authorizer <- case spec.authorizer.owner of
    Some p -> pure p
    None -> abort "allocation authorizer missing"
  factoryView <- exercise registry.allocationFactory Instr.AllocationFactory_PublicFetch with actors = [authorizer]
  assertMsg "allocation factory admin must be the instrument admin" (factoryView.admin == registry.instrument.admin)
  now <- getTime
  result <- exercise registry.allocationFactory Instr.AllocationFactory_Allocate with
    settlement
    allocation = spec
    requestedAt = now
    inputHoldingCids
    extraArgs
    actors = [authorizer]
  allocationCid <- case result.output of
    Instr.AllocationInstructionResult_Completed allocationCid -> pure allocationCid
    _ -> abort "allocation did not complete in one step"
  checkAllocation allocationCid registry.instrument settlement spec
  pure allocationCid

-- | Settle one transfer leg: the sender's and the receiver's allocations, both
-- already verified, through the pinned settlement factory.
settle : Registry -> Token.SettlementInfo -> Token.TransferLeg -> ContractId Token.Allocation -> ContractId Token.Allocation -> ExtraArgs -> Update ()
settle registry settlement leg senderCid receiverCid extraArgs = do
  factoryView <- exercise registry.settlementFactory Token.SettlementFactory_PublicFetch with actors = settlement.executors
  assertMsg "settlement factory admin must be the instrument admin" (factoryView.admin == registry.instrument.admin)
  result <- exercise registry.settlementFactory Token.SettlementFactory_SettleBatch with
    settlement
    transferLegs = [leg]
    allocations =
      [ Token.FinalizedAllocation with allocationCid = senderCid; extraTransferLegSides = []; nextIterationFunding = None
      , Token.FinalizedAllocation with allocationCid = receiverCid; extraTransferLegSides = []; nextIterationFunding = None
      ]
    actors = settlement.executors
    extraArgs
  let settled r = case r.output of
        Token.AllocationResult_Settled _ -> True
        _ -> False
  assertMsg "transfer did not settle" (length result.allocationSettleResults == 2 && all settled result.allocationSettleResults)

-- | Move one amount between the counterparties: allocate both sides through
-- the pinned allocation factory and settle them as one batch.
transfer : Registry -> Token.SettlementInfo -> Text -> Party -> Party -> Decimal -> Time -> [ContractId Holding.Holding] -> TransferArgs -> Update ()
transfer registry settlement legId sender receiver amount deadline inputHoldingCids args = do
  let instrument = registry.instrument
  senderCid <- allocate registry settlement (sendSpec instrument legId sender receiver amount deadline) inputHoldingCids args.sendArgs
  receiverCid <- allocate registry settlement (receiveSpec instrument legId sender receiver amount deadline) [] args.receiveArgs
  settle registry settlement (transferLeg instrument legId sender receiver amount) senderCid receiverCid args.settleArgs

-- | Registry choice context for each call of one transfer. Each registry
-- serves its own context per call, so they are passed separately.
data TransferArgs = TransferArgs
  with
    sendArgs : ExtraArgs
    receiveArgs : ExtraArgs
    settleArgs : ExtraArgs
  deriving (Eq, Show)

-- | The lender's terms, before funding. Created and funded in one command
-- (create-and-exercise), so an offer only ever exists with its principal
-- already committed.
template TokenOfferRequest
  with
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    principalRegistry : Registry
    collateralRegistry : Registry
    principal : Decimal
    interest : Decimal
    collateralQuantity : Decimal
    maturity : Time
    liquidationThresholdLtv : Decimal
    marginCallWindowSeconds : Int
    settlementRef : Text
    expiresAt : Time
  where
    signatory lender

    -- | Check the terms on a fresh mark and commit the principal in an
    -- allocation that only lender and borrower together can settle or cancel.
    choice FundTokenOffer : ContractId TokenLoanOffer
      with
        valuationCid : ContractId CollateralValuation
        inputHoldingCids : [ContractId Holding.Holding]
        extraArgs : ExtraArgs
      controller lender
      do
        validateOfferTerms lender borrower regulator principal interest collateralQuantity maturity (Some expiresAt)
        mark <- fetch valuationCid
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralRegistry.instrument.id mark.streamId valuationCid
        assertMsg "offer LTV must be below the liquidation threshold"
          (ltvBelow liquidationThresholdLtv principal collateralQuantity unitPrice)
        let settlementAnchor = coerceContractId self
        fundingAllocationCid <- allocate principalRegistry (loanSettlement lender borrower settlementAnchor (fundingRef settlementRef))
          (fundingSpec principalRegistry.instrument lender borrower principal expiresAt) inputHoldingCids extraArgs
        create TokenLoanOffer with
          lender; borrower; regulator; valuationAgent
          valuationStreamId = mark.streamId
          principalRegistry; collateralRegistry
          principal; interest; collateralQuantity; maturity
          liquidationThresholdLtv; marginCallWindowSeconds; settlementRef; settlementAnchor; expiresAt
          fundingAllocationCid

fundingSpec : Instrument -> Party -> Party -> Decimal -> Time -> Token.AllocationSpecification
fundingSpec instrument lender borrower principal expiresAt = sendSpec instrument "principal" lender borrower principal expiresAt

-- | A funded offer to one borrower. The principal stays committed until the
-- offer expires; the lender, its only signatory, can archive the offer to stop
-- acceptance, but recovers the principal only after expiry.
template TokenLoanOffer
  with
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    valuationStreamId : ContractId ValuationStream
    principalRegistry : Registry
    collateralRegistry : Registry
    principal : Decimal
    interest : Decimal
    collateralQuantity : Decimal
    maturity : Time
    liquidationThresholdLtv : Decimal
    marginCallWindowSeconds : Int
    settlementRef : Text
    settlementAnchor : AnyContractId
    expiresAt : Time
    fundingAllocationCid : ContractId Token.Allocation
  where
    signatory lender
    observer borrower, regulator

    ensure principal > 0.0 && interest >= 0.0 && collateralQuantity > 0.0
      && liquidationThresholdLtv > 0.0 && liquidationThresholdLtv <= 100.0
      && marginCallWindowSeconds >= 60 && marginCallWindowSeconds <= 86400
      && lender /= borrower && settlementRef /= "" && expiresAt <= maturity
      && valuationAgent /= lender && valuationAgent /= borrower && valuationAgent /= regulator
      && registryIndependent lender borrower principalRegistry && registryIndependent lender borrower collateralRegistry

    -- | In one transaction: recheck LTV on a fresh mark, verify the funding is
    -- the registry's own committed allocation for exactly these terms, lock
    -- the borrower's collateral, and settle the principal to the borrower.
    choice AcceptTokenOffer : ContractId TokenLoan
      with
        valuationCid : ContractId CollateralValuation
        collateralHoldingCids : [ContractId Holding.Holding]
        lockArgs : ExtraArgs
        receiveArgs : ExtraArgs
        settleArgs : ExtraArgs
      controller borrower
      do
        assertOfferLive maturity (Some expiresAt)
        unitPrice <- checkedPrice valuationAgent lender borrower regulator collateralRegistry.instrument.id valuationStreamId valuationCid
        assertMsg "acceptance LTV must be below the liquidation threshold"
          (ltvBelow liquidationThresholdLtv principal collateralQuantity unitPrice)
        let funding = loanSettlement lender borrower settlementAnchor (fundingRef settlementRef)
            principalInstrument = principalRegistry.instrument
        checkAllocation fundingAllocationCid principalInstrument funding
          (fundingSpec principalInstrument lender borrower principal expiresAt)
        lockCid <- allocate collateralRegistry (loanSettlement lender borrower settlementAnchor (collateralRef settlementRef))
          (lockSpec collateralRegistry.instrument lender borrower collateralQuantity maturity)
          collateralHoldingCids lockArgs
        receiptCid <- allocate principalRegistry funding
          (receiveSpec principalInstrument "principal" lender borrower principal expiresAt) [] receiveArgs
        settle principalRegistry funding (transferLeg principalInstrument "principal" lender borrower principal)
          fundingAllocationCid receiptCid settleArgs
        create TokenLoan with
          lender; borrower; regulator; valuationAgent; valuationStreamId
          principalRegistry; collateralRegistry
          principal; interest; collateralQuantity; maturity
          liquidationThresholdLtv; marginCallWindowSeconds; settlementRef; settlementAnchor; lockCid
          marginCall = None
          amountRepaid = 0.0
          payments = 0

    -- | Borrower declines; the executors cancel the funding and the principal
    -- returns to the lender.
    choice RejectTokenOffer : ()
      with
        cancelArgs : ExtraArgs
      controller borrower
      do
        cancelAllocation fundingAllocationCid principalRegistry.instrument
          (loanSettlement lender borrower settlementAnchor (fundingRef settlementRef)) cancelArgs

    -- | The principal is committed until the offer expires; after that the
    -- lender withdraws
    -- the funding, which the registry now allows its authorizer alone.
    choice WithdrawTokenOffer : ()
      with
        withdrawArgs : ExtraArgs
      controller lender
      do
        now <- getTime
        assertMsg "the funding is committed until the offer expires" (now > expiresAt)
        _ <- checkSettlement fundingAllocationCid principalRegistry.instrument
          (loanSettlement lender borrower settlementAnchor (fundingRef settlementRef))
        result <- exercise fundingAllocationCid Token.Allocation_Withdraw with
          actors = [lender]
          extraArgs = withdrawArgs
        case result.output of
          Token.AllocationResult_Withdrawn -> pure ()
          _ -> abort "funding allocation was not withdrawn"

-- | A registry admin must be neither counterparty: it would otherwise sign
-- allocations and transfers on its own behalf.
registryIndependent : Party -> Party -> Registry -> Bool
registryIndependent lender borrower registry =
  registry.instrument.admin /= lender && registry.instrument.admin /= borrower && registry.instrument.id /= ""

lockSpec : Instrument -> Party -> Party -> Decimal -> Time -> Token.AllocationSpecification
lockSpec instrument lender borrower quantity maturity = sendSpec instrument "collateral" borrower lender quantity (lockDeadline maturity)

-- | The lender's receiving side of a liquidation.
seizureSpec : Instrument -> Party -> Party -> Decimal -> Time -> Token.AllocationSpecification
seizureSpec instrument lender borrower quantity maturity = receiveSpec instrument "collateral" borrower lender quantity (lockDeadline maturity)

-- | Cancel with the executors' authority, after re-verifying that the
-- allocation is the registry's own.
cancelAllocation : ContractId Token.Allocation -> Instrument -> Token.SettlementInfo -> ExtraArgs -> Update ()
cancelAllocation allocationCid instrument settlement extraArgs = do
  _ <- checkSettlement allocationCid instrument settlement
  result <- exercise allocationCid Token.Allocation_Cancel with
    actors = settlement.executors
    extraArgs
  case result.output of
    Token.AllocationResult_Cancelled -> pure ()
    _ -> abort "allocation was not cancelled"

-- | Open loan: the principal has been paid out and the collateral is locked
-- in a committed allocation that lender and borrower execute together.
template TokenLoan
  with
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    valuationStreamId : ContractId ValuationStream
    principalRegistry : Registry
    collateralRegistry : Registry
    principal : Decimal
    interest : Decimal
    collateralQuantity : Decimal
    maturity : Time
    liquidationThresholdLtv : Decimal
    marginCallWindowSeconds : Int
    settlementRef : Text
    settlementAnchor : AnyContractId
    lockCid : ContractId Token.Allocation
    marginCall : Optional MarginCallDetails
    amountRepaid : Decimal
    -- Payments settled so far; numbers each payment's settlement id.
    payments : Int
  where
    signatory lender, borrower
    observer regulator

    ensure principal > 0.0 && interest >= 0.0 && collateralQuantity > 0.0
      && liquidationThresholdLtv > 0.0 && liquidationThresholdLtv <= 100.0
      && lender /= borrower && settlementRef /= ""
      && amountRepaid >= 0.0 && amountRepaid < principal + interest && payments >= 0

    choice IssueTokenMarginCall : ContractId TokenLoan
      with
        valuationCid : ContractId CollateralValuation
      controller lender
      do
        now <- getTime
        assertMsg "cannot issue a margin call at or after maturity" (now < maturity)
        assertMsg "a margin call is already open" (marginCall == None)
        unitPrice <- markOf this valuationCid
        assertMsg "margin call requires an LTV breach"
          (ltvAtOrAbove liquidationThresholdLtv (outstandingPrincipal principal interest (Some amountRepaid)) collateralQuantity unitPrice)
        let call = MarginCallDetails with
              issuedAt = now
              deadline = addRelTime now (seconds marginCallWindowSeconds)
              unitPrice
        create this with marginCall = Some call

    choice ResolveTokenMarginCall : ContractId TokenLoan
      with
        valuationCid : ContractId CollateralValuation
      controller borrower
      do
        now <- getTime
        assertMsg "cannot resolve a margin call at or after maturity" (now < maturity)
        assertMsg "no margin call is open" (marginCall /= None)
        unitPrice <- markOf this valuationCid
        assertMsg "collateral remains below the required value"
          (ltvBelow liquidationThresholdLtv (outstandingPrincipal principal interest (Some amountRepaid)) collateralQuantity unitPrice)
        create this with marginCall = None

    -- | Pay part of the balance. During a margin call the payment must bring
    -- LTV back under the threshold, and then clears the call.
    choice PayDownToken : ContractId TokenLoan
      with
        amount : Decimal
        paymentHoldingCids : [ContractId Holding.Holding]
        args : TransferArgs
        valuationCid : Optional (ContractId CollateralValuation)
      controller borrower
      do
        now <- getTime
        assertMsg "cannot pay down at or after maturity" (now < maturity)
        assertMsg "payment must be positive" (amount > 0.0)
        let paid = amountRepaid + amount
        assertMsg "a partial payment must be less than the outstanding balance; use Repay to settle"
          (paid < principal + interest)
        cured <- case marginCall of
          None -> pure False
          Some _ -> do
            markCid <- case valuationCid of
              None -> abort "a fresh valuation is required to pay down during a margin call"
              Some markCid -> pure markCid
            unitPrice <- markOf this markCid
            assertMsg "payment must restore LTV below the threshold while a margin call is open"
              (ltvBelow liquidationThresholdLtv (outstandingPrincipal principal interest (Some paid)) collateralQuantity unitPrice)
            pure True
        payLender this amount paymentHoldingCids args
        create this with
          amountRepaid = paid
          payments = payments + 1
          marginCall = if cured then None else marginCall

    -- | Pay the outstanding balance and, in the same transaction, cancel the
    -- collateral lock so the collateral returns to the borrower.
    choice RepayToken : ContractId TokenLoanClosed
      with
        paymentHoldingCids : [ContractId Holding.Holding]
        args : TransferArgs
        cancelArgs : ExtraArgs
      controller borrower
      do
        let owed = principal + interest - amountRepaid
        payLender this owed paymentHoldingCids args
        releaseCollateral this cancelArgs
        closeTokenLoan this "Repaid" True (principal + interest) None

    -- | After an expired call, on a fresh mark that still breaches, the locked
    -- collateral settles to the lender.
    choice LiquidateToken : ContractId TokenLoanClosed
      with
        valuationCid : ContractId CollateralValuation
        receiveArgs : ExtraArgs
        settleArgs : ExtraArgs
      controller lender
      do
        call <- case marginCall of
          None -> abort "liquidation requires an open margin call"
          Some call -> pure call
        now <- getTime
        assertMsg "margin call deadline has not passed" (now >= call.deadline)
        unitPrice <- markOf this valuationCid
        assertMsg "liquidation requires an LTV breach"
          (ltvAtOrAbove liquidationThresholdLtv (outstandingPrincipal principal interest (Some amountRepaid)) collateralQuantity unitPrice)
        seizeCollateral this receiveArgs settleArgs
        closeTokenLoan this "Liquidated" False amountRepaid (Some unitPrice)

    -- | An unpaid loan past maturity: the lock settles to the lender until the
    -- lock deadline, a day after maturity.
    choice LiquidateTokenOverdue : ContractId TokenLoanClosed
      with
        receiveArgs : ExtraArgs
        settleArgs : ExtraArgs
      controller lender
      do
        now <- getTime
        assertMsg "loan is not past maturity" (now > maturity)
        seizeCollateral this receiveArgs settleArgs
        closeTokenLoan this "LiquidatedAtMaturity" False amountRepaid None

    -- | The lender forgives the balance and releases the collateral.
    choice WriteOffToken : ContractId TokenLoanClosed
      with
        cancelArgs : ExtraArgs
      controller lender
      do
        releaseCollateral this cancelArgs
        closeTokenLoan this "WrittenOff" True amountRepaid None

    -- | After the lock deadline the registry refuses to settle and the
    -- borrower may withdraw the collateral, so no other choice can close the
    -- loan. The lock is not touched: it may already be withdrawn. Nothing is
    -- seized; the unpaid balance stays on the record.
    choice CloseLapsedTokenLoan : ContractId TokenLoanClosed
      controller lender
      do
        now <- getTime
        assertMsg "the collateral lock has not lapsed: lock deadline not passed" (now > lockDeadline maturity)
        closeTokenLoan this "CollateralLapsed" True amountRepaid None

    -- | Swap in new factories for the same instruments, for example after
    -- registry maintenance archived the pinned ones, which would otherwise
    -- block repayment. Both counterparties authorize it (RegistryChange).
    choice ReplaceRegistries : ContractId TokenLoan
      with
        newPrincipalRegistry : Registry
        newCollateralRegistry : Registry
      controller lender, borrower
      do
        assertMsg "a registry change cannot change the instruments"
          (newPrincipalRegistry.instrument == principalRegistry.instrument
            && newCollateralRegistry.instrument == collateralRegistry.instrument)
        forA_ [newPrincipalRegistry, newCollateralRegistry] (checkFactories lender)
        create this with principalRegistry = newPrincipalRegistry; collateralRegistry = newCollateralRegistry

-- | One counterparty's proposal to replace a loan's pinned factories; the
-- other accepts it, which supplies both authorities to ReplaceRegistries.
template RegistryChange
  with
    proposer : Party
    counterparty : Party
    loanCid : ContractId TokenLoan
    newPrincipalRegistry : Registry
    newCollateralRegistry : Registry
  where
    signatory proposer
    observer counterparty
    ensure proposer /= counterparty

    choice AcceptRegistryChange : ContractId TokenLoan
      controller counterparty
      do
        exercise loanCid ReplaceRegistries with newPrincipalRegistry; newCollateralRegistry

    choice RejectRegistryChange : ()
      controller counterparty
      do
        pure ()

    choice WithdrawRegistryChange : ()
      controller proposer
      do
        pure ()

-- | Both factories of a registry must answer for its instrument admin.
checkFactories : Party -> Registry -> Update ()
checkFactories actor registry = do
  allocationView <- exercise registry.allocationFactory Instr.AllocationFactory_PublicFetch with actors = [actor]
  settlementView <- exercise registry.settlementFactory Token.SettlementFactory_PublicFetch with actors = [actor]
  assertMsg "registry factories must answer for the instrument admin"
    (allocationView.admin == registry.instrument.admin && settlementView.admin == registry.instrument.admin)

markOf : TokenLoan -> ContractId CollateralValuation -> Update Decimal
markOf loan = checkedPrice loan.valuationAgent loan.lender loan.borrower loan.regulator
  loan.collateralRegistry.instrument.id loan.valuationStreamId

payLender : TokenLoan -> Decimal -> [ContractId Holding.Holding] -> TransferArgs -> Update ()
payLender loan amount paymentHoldingCids args = do
  now <- getTime
  transfer loan.principalRegistry (loanSettlement loan.lender loan.borrower loan.settlementAnchor (paymentRef loan.settlementRef (loan.payments + 1)))
    "payment" loan.borrower loan.lender amount (addRelTime now paymentWindow) paymentHoldingCids args

lockSettlement : TokenLoan -> Token.SettlementInfo
lockSettlement loan = loanSettlement loan.lender loan.borrower loan.settlementAnchor (collateralRef loan.settlementRef)

releaseCollateral : TokenLoan -> ExtraArgs -> Update ()
releaseCollateral loan = cancelAllocation loan.lockCid loan.collateralRegistry.instrument (lockSettlement loan)

-- A committed allocation settles exactly its one fixed leg, so liquidation
-- always transfers the whole locked quantity; the close record says so rather
-- than implying a surplus refund.
seizeCollateral : TokenLoan -> ExtraArgs -> ExtraArgs -> Update ()
seizeCollateral loan receiveArgs settleArgs = do
  let instrument = loan.collateralRegistry.instrument
      settlement = lockSettlement loan
  _ <- checkSettlement loan.lockCid instrument settlement
  receiptCid <- allocate loan.collateralRegistry settlement
    (seizureSpec instrument loan.lender loan.borrower loan.collateralQuantity loan.maturity) [] receiveArgs
  settle loan.collateralRegistry settlement (transferLeg instrument "collateral" loan.borrower loan.lender loan.collateralQuantity)
    loan.lockCid receiptCid settleArgs

closeTokenLoan : TokenLoan -> Text -> Bool -> Decimal -> Optional Decimal -> Update (ContractId TokenLoanClosed)
closeTokenLoan loan reason collateralReleased amountRepaid liquidationUnitPrice = do
  now <- getTime
  create TokenLoanClosed with
    lender = loan.lender
    borrower = loan.borrower
    regulator = loan.regulator
    valuationAgent = loan.valuationAgent
    valuationStreamId = loan.valuationStreamId
    principalInstrument = loan.principalRegistry.instrument
    collateralInstrument = loan.collateralRegistry.instrument
    principal = loan.principal
    interest = loan.interest
    collateralQuantity = loan.collateralQuantity
    maturity = loan.maturity
    settlementRef = loan.settlementRef
    reason
    collateralReleased
    amountRepaid
    closedAt = now
    liquidationUnitPrice
    collateralSeized = if collateralReleased then 0.0 else loan.collateralQuantity
    collateralReturned = if collateralReleased then loan.collateralQuantity else 0.0

-- | Settlement record of a closed token loan, kept by both counterparties.
template TokenLoanClosed
  with
    lender : Party
    borrower : Party
    regulator : Party
    valuationAgent : Party
    valuationStreamId : ContractId ValuationStream
    principalInstrument : Instrument
    collateralInstrument : Instrument
    principal : Decimal
    interest : Decimal
    collateralQuantity : Decimal
    maturity : Time
    settlementRef : Text
    reason : Text
    collateralReleased : Bool
    amountRepaid : Decimal
    closedAt : Time
    liquidationUnitPrice : Optional Decimal
    collateralSeized : Decimal
    collateralReturned : Decimal
  where
    signatory lender, borrower
    observer regulator

    -- | Both counterparties must agree, so neither can erase the other's
    -- proof of settlement alone.
    choice DismissTokenLoanClosed : ()
      controller lender, borrower
      do
        pure ()

-- ---------------------------------------------------------------------------
-- Origination and close-out rules added in 0.9.0 (docs/AUDIT-TRIAGE.md).

-- Close-out netting: the lender takes only the units that cover the balance at
-- the attested mark, rounded up to the Decimal grain, capped at what is locked.
seizedQuantity : Decimal -> Decimal -> Decimal -> Decimal
seizedQuantity locked owed unitPrice
  | owed >= locked * unitPrice = locked
  | otherwise =
      -- Compare at scale 20: at scale 10 the product can round up to exactly
      -- `owed` although the rounded-down quantity is worth slightly less.
      let units = owed / unitPrice
          value = mul units unitPrice : Numeric 20
          covering = if value < cast owed then units + 0.0000000001 else units
      in min locked covering

-- Upper bounds keep every sum (principal + interest, quantity × price) far
-- from the Decimal limit and reject terms entered in the wrong unit.
maxTermAmount : Decimal
maxTermAmount = 1000000000000.0

maxTermDays : Int
maxTermDays = 3660

-- Terms checked once, at origination, for both collateral types.
validateOfferTerms : Party -> Party -> Party -> Decimal -> Decimal -> Decimal -> Time -> Optional Time -> Update ()
validateOfferTerms lender borrower regulator principal interest collateralQuantity maturity expiresAt = do
  now <- getTime
  assertMsg "offer maturity must be in the future" (now < maturity)
  assertMsg "offer maturity must be within ten years" (maturity <= addRelTime now (days maxTermDays))
  assertMsg "principal must be positive" (principal > 0.0)
  assertMsg "principal exceeds the maximum" (principal <= maxTermAmount)
  assertMsg "interest must be between zero and the principal" (interest >= 0.0 && interest <= principal)
  assertMsg "collateral quantity must be positive" (collateralQuantity > 0.0)
  assertMsg "collateral quantity exceeds the maximum" (collateralQuantity <= maxTermAmount)
  assertMsg "regulator must differ from lender and borrower" (regulator /= lender && regulator /= borrower)
  case expiresAt of
    None -> pure ()
    Some expiry -> assertMsg "offer expiry must be in the future and no later than maturity" (now < expiry && expiry <= maturity)

assertOfferLive : Time -> Optional Time -> Update ()
assertOfferLive maturity expiresAt = do
  now <- getTime
  assertMsg "cannot accept an offer at or after maturity" (now < maturity)
  case expiresAt of
    None -> pure ()
    Some expiry -> assertMsg "offer has expired" (now < expiry)
