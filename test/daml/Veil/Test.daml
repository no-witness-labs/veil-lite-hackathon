module Veil.Test where

import Daml.Script
import DA.Assert ((===))
import DA.Date
import DA.List (sort)
import DA.Time (addRelTime, days, seconds, time)
import Veil
import Veil.CoinMocks
import Splice.Api.Token.AllocationInstructionV2 qualified as Instr
import Splice.Api.Token.AllocationV2 qualified as Token
import Splice.Api.Token.MetadataV1 (ExtraArgs(..), emptyChoiceContext, emptyMetadata)

tbill : Text
tbill = "Tokenized T-Bill / MMF"

testStart : Time
testStart = time (date 2030 Jan 1) 12 0 0

maturityTime : Time
maturityTime = time (date 2030 Feb 1) 12 0 0

shortMaturity : Time
shortMaturity = addRelTime testStart (seconds 60)

-- The fixture has one shared stream and its current agreed mark at unit price
-- 1.0. The stream's three signatories authorize each initial publication.
-- Holdings are issued by a distinct trusted issuer; issuance requires both the
-- issuer and the eventual owner to authorize the create.
setup : Script ((Party, Party, Party, Party, Party, ContractId ValuationStream), (ContractId CollateralValuation, ContractId CashHolding, ContractId CashHolding, ContractId CollateralHolding))
setup = do
  issuer <- allocateParty "Issuer"
  lender <- allocateParty "Lender"
  borrower <- allocateParty "Borrower"
  regulator <- allocateParty "Regulator"
  valuationAgent <- allocateParty "ValuationAgent"
  streamCid <- (actAs lender <> actAs borrower <> actAs valuationAgent) `submit` do
    createCmd ValuationStream with
      valuationAgent
      lender
      borrower
      regulator
      collateralAsset = tbill
  initialMark <- submit valuationAgent do
    exerciseCmd streamCid PublishInitial with unitPrice = 1.0
  lenderCash <- issueCash issuer lender 100.0
  borrowerCash <- issueCash issuer borrower 105.0
  borrowerColl <- issueCollateral issuer borrower tbill 150.0
  pure ((issuer, lender, borrower, regulator, valuationAgent, streamCid), (initialMark, lenderCash, borrowerCash, borrowerColl))

issueCash : Party -> Party -> Decimal -> Script (ContractId CashHolding)
issueCash issuer owner amount =
  (actAs issuer <> actAs owner) `submit` do
    createCmd CashHolding with issuer; owner; amount

issueCollateral : Party -> Party -> Text -> Decimal -> Script (ContractId CollateralHolding)
issueCollateral issuer owner asset quantity =
  (actAs issuer <> actAs owner) `submit` do
    createCmd CollateralHolding with issuer; owner; asset; quantity

createStream : Party -> Party -> Party -> Party -> Text -> Script (ContractId ValuationStream)
createStream lender borrower regulator valuationAgent asset =
  (actAs lender <> actAs borrower <> actAs valuationAgent) `submit` do
    createCmd ValuationStream with
      valuationAgent
      lender
      borrower
      regulator
      collateralAsset = asset

publishInitial : Party -> ContractId ValuationStream -> Decimal -> Script (ContractId CollateralValuation)
publishInitial valuationAgent streamCid unitPrice =
  submit valuationAgent do exerciseCmd streamCid PublishInitial with unitPrice

publishPrice : Party -> ContractId CollateralValuation -> Decimal -> Script (ContractId CollateralValuation)
publishPrice valuationAgent markCid unitPrice =
  submit valuationAgent do exerciseCmd markCid Publish with unitPrice

makeOfferAt : Party -> Party -> Party -> Party -> ContractId CashHolding -> ContractId CollateralValuation -> Time -> Script (ContractId LoanOffer)
makeOfferAt lender borrower regulator valuationAgent lenderCash valuationCid maturity =
  submit lender do
    exerciseCmd lenderCash MakeOffer with
      borrower
      regulator
      valuationAgent
      valuationCid
      principal = 100.0
      interest = 5.0
      collateralAsset = tbill
      collateralQuantity = 150.0
      maturity
      liquidationThresholdLtv = 90.0
      marginCallWindowSeconds = 60

makeOffer : Party -> Party -> Party -> Party -> ContractId CashHolding -> ContractId CollateralValuation -> Script (ContractId LoanOffer)
makeOffer lender borrower regulator valuationAgent lenderCash valuationCid =
  makeOfferAt lender borrower regulator valuationAgent lenderCash valuationCid maturityTime

makeCustomOffer : Party -> Party -> Party -> Party -> ContractId CashHolding -> ContractId CollateralValuation -> Decimal -> Decimal -> Decimal -> Time -> Script (ContractId LoanOffer)
makeCustomOffer lender borrower regulator valuationAgent lenderCash valuationCid principal collateralQuantity threshold maturity =
  submit lender do
    exerciseCmd lenderCash MakeOffer with
      borrower
      regulator
      valuationAgent
      valuationCid
      principal
      interest = 5.0
      collateralAsset = tbill
      collateralQuantity
      maturity
      liquidationThresholdLtv = threshold
      marginCallWindowSeconds = 60

acceptLoan : Party -> ContractId LoanOffer -> ContractId CollateralHolding -> ContractId CollateralValuation -> Script (ContractId Loan)
acceptLoan borrower offerCid collateralCid valuationCid =
  submit borrower do exerciseCmd offerCid Accept with collateralCid; valuationCid

cashAmounts : Party -> Script [Decimal]
cashAmounts p = do
  hs <- query @CashHolding p
  pure $ sort [h.amount | (_, h) <- hs]

collateralQuantities : Party -> Script [Decimal]
collateralQuantities p = do
  hs <- query @CollateralHolding p
  pure $ sort [h.quantity | (_, h) <- hs]

testFullLifecycle : Script ()
testFullLifecycle = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, streamCid), (initialMark, lenderCash, borrowerCash, borrowerColl)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  query @LoanOffer regulator >>= \offers -> length offers === 1
  Some offer <- queryContractId lender offerCid
  offer.issuer === issuer
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  Some loan <- queryContractId borrower loanCid
  loan.collateralLocked === True
  loan.principal === 100.0
  loan.interest === 5.0
  loan.collateralQuantity === 150.0
  loan.issuer === issuer
  loan.valuationAgent === valuationAgent
  loan.valuationStreamId === streamCid
  loan.marginCallWindowSeconds === 60
  loan.marginCall === None
  query @Loan regulator >>= \loans -> length loans === 1
  query @CollateralHolding borrower >>= \holdings -> length holdings === 0
  cashAmounts borrower >>= \amounts -> amounts === [100.0, 105.0]
  query @CashHolding borrower >>= \holdings -> [h.issuer | (_, h) <- holdings] === [issuer, issuer]
  outsider <- allocateParty "Outsider"
  query @Loan outsider >>= \loans -> length loans === 0
  query @Loan valuationAgent >>= \loans -> length loans === 0
  closedCid <- submit borrower do exerciseCmd loanCid Repay with repaymentCid = borrowerCash
  query @Loan borrower >>= \loans -> length loans === 0
  query @CollateralHolding borrower >>= \holdings -> do
    length holdings === 1
    [h.issuer | (_, h) <- holdings] === [issuer]
  query @CashHolding borrower >>= \holdings -> [h.issuer | (_, h) <- holdings] === [issuer]
  Some closed <- queryContractId regulator closedCid
  closed.reason === "Repaid"
  closed.collateralReleased === True
  closed.valuationStreamId === streamCid
  cashAmounts lender >>= \amounts -> amounts === [105.0]
  cashAmounts borrower >>= \amounts -> amounts === [100.0]
  query @CashHolding lender >>= \holdings -> [h.issuer | (_, h) <- holdings] === [issuer]
  query @CollateralHolding borrower >>= \holdings -> [h.issuer | (_, h) <- holdings] === [issuer]
  query @LoanClosed outsider >>= \closedLoans -> length closedLoans === 0

testWithdrawRefunds : Script ()
testWithdrawRefunds = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, _)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  query @CashHolding lender >>= \holdings -> length holdings === 0
  refundCid <- submit lender do exerciseCmd offerCid Withdraw
  Some refund <- queryContractId lender refundCid
  refund.issuer === issuer
  cashAmounts lender >>= \amounts -> amounts === [100.0]
  query @LoanOffer borrower >>= \offers -> length offers === 0

testRepayExactAmountViaSplit : Script ()
testRepayExactAmountViaSplit = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  oversized <- issueCash issuer borrower 5000.0
  submitMustFail borrower do exerciseCmd loanCid Repay with repaymentCid = oversized
  (exactCid, remainderCid) <- submit borrower do exerciseCmd oversized Split with splitAmount = 105.0
  Some exact <- queryContractId borrower exactCid
  exact.amount === 105.0
  exact.issuer === issuer
  Some remainder <- queryContractId borrower remainderCid
  remainder.amount === 4895.0
  remainder.issuer === issuer
  closedCid <- submit borrower do exerciseCmd loanCid Repay with repaymentCid = exactCid
  Some closed <- queryContractId regulator closedCid
  closed.reason === "Repaid"
  closed.issuer === issuer
  closed.collateralReleased === True
  cashAmounts lender >>= \amounts -> amounts === [105.0]
  cashAmounts borrower >>= \amounts -> amounts === [100.0, 105.0, 4895.0]
  collateralQuantities borrower >>= \quantities -> quantities === [150.0]

testStreamReplacementAndPrivacy : Script ()
testStreamReplacementAndPrivacy = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, streamCid), (initialMark, lenderCash, _, borrowerColl)) <- setup
  replacement <- publishPrice valuationAgent initialMark 1.1
  None <- queryContractId valuationAgent initialMark
  Some current <- queryContractId lender replacement
  current.streamId === streamCid
  current.unitPrice === 1.1
  submitMustFail valuationAgent do exerciseCmd initialMark Publish with unitPrice = 1.2
  query @CollateralValuation regulator >>= \marks -> length marks === 1
  submitMustFail regulator do exerciseCmd replacement Publish with unitPrice = 1.2
  query @ValuationStream lender >>= \streams -> length streams === 0
  outsider <- allocateParty "Outsider"
  query @ValuationStream outsider >>= \streams -> length streams === 0
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash replacement
  loanCid <- acceptLoan borrower offerCid borrowerColl replacement
  query @Loan valuationAgent >>= \loans -> length loans === 0
  query @Loan regulator >>= \loans -> length loans === 1
  query @Loan outsider >>= \loans -> length loans === 0
  Some loan <- queryContractId borrower loanCid
  loan.valuationStreamId === streamCid

-- Archived predecessor marks cannot be fetched even though they would still
-- be within the normal five-minute freshness window.
testArchivedMarkRejected : Script ()
testArchivedMarkRejected = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  breachOne <- publishPrice valuationAgent initialMark 0.5
  healthyOne <- publishPrice valuationAgent breachOne 0.8
  submitMustFail lender do exerciseCmd loanCid IssueMarginCall with valuationCid = breachOne
  breachTwo <- publishPrice valuationAgent healthyOne 0.5
  calledLoanCid <- submit lender do exerciseCmd loanCid IssueMarginCall with valuationCid = breachTwo
  healthyTwo <- publishPrice valuationAgent breachTwo 0.8
  topUpHolding <- issueCollateral issuer borrower tbill 50.0
  submitMustFail borrower do
    exerciseCmd calledLoanCid TopUpCollateral with
      collateralCid = topUpHolding
      topUpQuantity = 50.0
      valuationCid = breachTwo
  submitMustFail borrower do exerciseCmd calledLoanCid ResolveMarginCall with valuationCid = breachTwo
  passTime (seconds 60)
  submitMustFail lender do exerciseCmd calledLoanCid Liquidate with valuationCid = breachTwo
  Some current <- queryContractId valuationAgent healthyTwo
  current.unitPrice === 0.8

testParallelStreamAndForgedMarks : Script ()
testParallelStreamAndForgedMarks = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, streamCid), (initialMark, lenderCash, _, borrowerColl)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  parallelStream <- createStream lender borrower regulator valuationAgent tbill
  parallelMark <- publishInitial valuationAgent parallelStream 0.5
  submitMustFail lender do exerciseCmd loanCid IssueMarginCall with valuationCid = parallelMark
  wrongAssetStream <- createStream lender borrower regulator valuationAgent "Other Asset"
  wrongAssetMark <- publishInitial valuationAgent wrongAssetStream 0.5
  submitMustFail lender do exerciseCmd loanCid IssueMarginCall with valuationCid = wrongAssetMark
  submitMustFail valuationAgent do
    createCmd CollateralValuation with
      valuationAgent; lender; borrower; regulator; collateralAsset = tbill
      streamId = streamCid; unitPrice = 0.5; observedAt = testStart
  submitMustFail lender do
    createCmd CollateralValuation with
      valuationAgent; lender; borrower; regulator; collateralAsset = tbill
      streamId = streamCid; unitPrice = 0.5; observedAt = testStart
  submitMustFail borrower do
    createCmd CollateralValuation with
      valuationAgent; lender; borrower; regulator; collateralAsset = tbill
      streamId = streamCid; unitPrice = 0.5; observedAt = testStart

testMarginCallTopUpAndRepay : Script ()
testMarginCallTopUpAndRepay = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, borrowerCash, borrowerColl)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  breachMark <- publishPrice valuationAgent initialMark 0.5
  calledLoanCid <- submit lender do exerciseCmd loanCid IssueMarginCall with valuationCid = breachMark
  Some calledLoan <- queryContractId borrower calledLoanCid
  Some call <- pure calledLoan.marginCall
  calledLoan.issuer === issuer
  call.unitPrice === 0.5
  call.deadline === addRelTime call.issuedAt (seconds 60)
  oversized <- issueCollateral issuer borrower tbill 100.0
  (exactCid, reserveCid) <- submit borrower do exerciseCmd oversized SplitCollateral with splitQuantity = 50.0
  Some exactTopUp <- queryContractId borrower exactCid
  exactTopUp.issuer === issuer
  healthyMark <- publishPrice valuationAgent breachMark 0.8
  toppedLoanCid <- submit borrower do
    exerciseCmd calledLoanCid TopUpCollateral with collateralCid = exactCid; topUpQuantity = 50.0; valuationCid = healthyMark
  Some toppedLoan <- queryContractId borrower toppedLoanCid
  toppedLoan.collateralQuantity === 200.0
  toppedLoan.marginCall === None
  toppedLoan.issuer === issuer
  closedCid <- submit borrower do exerciseCmd toppedLoanCid Repay with repaymentCid = borrowerCash
  Some closed <- queryContractId regulator closedCid
  closed.reason === "Repaid"
  closed.collateralQuantity === 200.0
  closed.issuer === issuer
  closed.valuationStreamId === calledLoan.valuationStreamId
  collateralQuantities borrower >>= \quantities -> quantities === [50.0, 200.0]
  Some reserve <- queryContractId borrower reserveCid
  reserve.quantity === 50.0
  reserve.issuer === issuer

testMarginCallDeadlineAndLiquidation : Script ()
testMarginCallDeadlineAndLiquidation = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  breachMark <- publishPrice valuationAgent initialMark 0.5
  calledLoanCid <- submit lender do exerciseCmd loanCid IssueMarginCall with valuationCid = breachMark
  submitMustFail lender do exerciseCmd calledLoanCid Liquidate with valuationCid = breachMark
  passTime (seconds 59)
  submitMustFail lender do exerciseCmd calledLoanCid Liquidate with valuationCid = breachMark
  passTime (seconds 1)
  closedCid <- submit lender do exerciseCmd calledLoanCid Liquidate with valuationCid = breachMark
  query @Loan borrower >>= \loans -> length loans === 0
  Some closed <- queryContractId borrower closedCid
  closed.reason === "Liquidated"
  closed.issuer === issuer
  closed.collateralReleased === False
  collateralQuantities lender >>= \quantities -> quantities === [150.0]
  query @CollateralHolding lender >>= \holdings -> [h.issuer | (_, h) <- holdings] === [issuer]

testResolveMarginCallAfterDeadline : Script ()
testResolveMarginCallAfterDeadline = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  breachMark <- publishPrice valuationAgent initialMark 0.5
  calledLoanCid <- submit lender do exerciseCmd loanCid IssueMarginCall with valuationCid = breachMark
  passTime (seconds 60)
  healthyMark <- publishPrice valuationAgent breachMark 1.0
  resolvedLoanCid <- submit borrower do exerciseCmd calledLoanCid ResolveMarginCall with valuationCid = healthyMark
  Some resolvedLoan <- queryContractId borrower resolvedLoanCid
  resolvedLoan.marginCall === None
  resolvedLoan.issuer === issuer

testRepayDuringOpenAndExpiredCall : Script ()
testRepayDuringOpenAndExpiredCall = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, borrowerCash, borrowerColl)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  breachMark <- publishPrice valuationAgent initialMark 0.5
  calledLoanCid <- submit lender do exerciseCmd loanCid IssueMarginCall with valuationCid = breachMark
  closedCid <- submit borrower do exerciseCmd calledLoanCid Repay with repaymentCid = borrowerCash
  Some closed <- queryContractId regulator closedCid
  closed.reason === "Repaid"

  ((issuer2, lender2, borrower2, regulator2, valuationAgent2, _), (initialMark2, lenderCash2, borrowerCash2, borrowerColl2)) <- setup
  offerCid2 <- makeOffer lender2 borrower2 regulator2 valuationAgent2 lenderCash2 initialMark2
  loanCid2 <- acceptLoan borrower2 offerCid2 borrowerColl2 initialMark2
  breachMark2 <- publishPrice valuationAgent2 initialMark2 0.5
  calledLoanCid2 <- submit lender2 do exerciseCmd loanCid2 IssueMarginCall with valuationCid = breachMark2
  passTime (seconds 60)
  closedCid2 <- submit borrower2 do exerciseCmd calledLoanCid2 Repay with repaymentCid = borrowerCash2
  Some closed2 <- queryContractId regulator2 closedCid2
  closed2.reason === "Repaid"

testNoCallAndRepay : Script ()
testNoCallAndRepay = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, borrowerCash, borrowerColl)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  healthyMark <- publishPrice valuationAgent initialMark 1.0
  extra <- issueCollateral issuer borrower tbill 50.0
  submitMustFail borrower do exerciseCmd loanCid TopUpCollateral with collateralCid = extra; topUpQuantity = 50.0; valuationCid = healthyMark
  submitMustFail borrower do exerciseCmd loanCid ResolveMarginCall with valuationCid = healthyMark
  passTime (seconds 60)
  submitMustFail lender do exerciseCmd loanCid Liquidate with valuationCid = healthyMark
  closedCid <- submit borrower do exerciseCmd loanCid Repay with repaymentCid = borrowerCash
  Some closed <- queryContractId regulator closedCid
  closed.reason === "Repaid"

testAuthorizationAndReadVisibility : Script ()
testAuthorizationAndReadVisibility = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, borrowerCash, borrowerColl)) <- setup
  outsider <- allocateParty "Outsider"
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  submitMustFail borrower do exerciseCmd offerCid Withdraw
  submitMustFail outsider do exerciseCmd offerCid Accept with collateralCid = borrowerColl; valuationCid = initialMark
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  query @Loan regulator >>= \loans -> length loans === 1
  query @Loan valuationAgent >>= \loans -> length loans === 0
  query @Loan outsider >>= \loans -> length loans === 0
  breachMark <- publishPrice valuationAgent initialMark 0.5
  submitMustFail borrower do exerciseCmd loanCid IssueMarginCall with valuationCid = breachMark
  submitMustFail valuationAgent do exerciseCmd loanCid IssueMarginCall with valuationCid = breachMark
  submitMustFail regulator do exerciseCmd loanCid IssueMarginCall with valuationCid = breachMark
  submitMustFail outsider do exerciseCmd loanCid IssueMarginCall with valuationCid = breachMark
  submitMustFail lender do exerciseCmd loanCid Repay with repaymentCid = borrowerCash
  submitMustFail regulator do exerciseCmd loanCid Repay with repaymentCid = borrowerCash

testValuationFreshnessAndGuards : Script ()
testValuationFreshnessAndGuards = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, streamCid), (initialMark, lenderCash, _, borrowerColl)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  passTime (seconds 301)
  submitMustFail lender do exerciseCmd loanCid IssueMarginCall with valuationCid = initialMark
  freshMark <- publishPrice valuationAgent initialMark 0.5
  wrongAssetStream <- createStream lender borrower regulator valuationAgent "Other Asset"
  wrongAssetMark <- publishInitial valuationAgent wrongAssetStream 0.5
  submitMustFail lender do exerciseCmd loanCid IssueMarginCall with valuationCid = wrongAssetMark
  wrongLender <- allocateParty "WrongLender"
  wrongBorrower <- allocateParty "WrongBorrower"
  wrongRegulator <- allocateParty "WrongRegulator"
  wrongAgent <- allocateParty "WrongAgent"
  wrongStream <- createStream wrongLender wrongBorrower wrongRegulator wrongAgent tbill
  wrongMark <- publishInitial wrongAgent wrongStream 0.5
  submitMustFail lender do exerciseCmd loanCid IssueMarginCall with valuationCid = wrongMark
  now <- getTime
  futureMark <- (actAs lender <> actAs borrower <> actAs valuationAgent) `submit` do
    createCmd CollateralValuation with
      valuationAgent; lender; borrower; regulator; collateralAsset = tbill
      streamId = streamCid; unitPrice = 0.5; observedAt = addRelTime now (seconds 1)
  submitMustFail lender do exerciseCmd loanCid IssueMarginCall with valuationCid = futureMark
  submitMustFail valuationAgent do
    createCmd CollateralValuation with
      valuationAgent; lender; borrower; regulator; collateralAsset = tbill
      streamId = streamCid; unitPrice = 0.5; observedAt = testStart
  Some current <- queryContractId lender freshMark
  current.unitPrice === 0.5

testDuplicateCallAndReusedContracts : Script ()
testDuplicateCallAndReusedContracts = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  firstMark <- publishPrice valuationAgent initialMark 0.5
  calledLoanCid <- submit lender do exerciseCmd loanCid IssueMarginCall with valuationCid = firstMark
  Some calledLoan <- queryContractId borrower calledLoanCid
  Some firstCall <- pure calledLoan.marginCall
  secondMark <- publishPrice valuationAgent firstMark 0.5
  submitMustFail lender do exerciseCmd calledLoanCid IssueMarginCall with valuationCid = secondMark
  Some stillCalledLoan <- queryContractId borrower calledLoanCid
  Some stillFirstCall <- pure stillCalledLoan.marginCall
  stillFirstCall.deadline === firstCall.deadline
  topUpHolding <- issueCollateral issuer borrower tbill 50.0
  healthyMark <- publishPrice valuationAgent secondMark 0.8
  toppedLoanCid <- submit borrower do exerciseCmd calledLoanCid TopUpCollateral with collateralCid = topUpHolding; topUpQuantity = 50.0; valuationCid = healthyMark
  secondBreach <- publishPrice valuationAgent healthyMark 0.5
  secondCallLoanCid <- submit lender do exerciseCmd toppedLoanCid IssueMarginCall with valuationCid = secondBreach
  healthyAgain <- publishPrice valuationAgent secondBreach 0.8
  submitMustFail borrower do exerciseCmd secondCallLoanCid TopUpCollateral with collateralCid = topUpHolding; topUpQuantity = 50.0; valuationCid = healthyAgain

testTopUpRollbackAndSplit : Script ()
testTopUpRollbackAndSplit = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  breachMark <- publishPrice valuationAgent initialMark 0.5
  calledLoanCid <- submit lender do exerciseCmd loanCid IssueMarginCall with valuationCid = breachMark
  oversized <- issueCollateral issuer borrower tbill 100.0
  healthyMark <- publishPrice valuationAgent breachMark 0.8
  submitMustFail borrower do exerciseCmd calledLoanCid TopUpCollateral with collateralCid = oversized; topUpQuantity = 50.0; valuationCid = healthyMark
  Some stillOversized <- queryContractId borrower oversized
  stillOversized.quantity === 100.0
  wrongAsset <- issueCollateral issuer borrower "Other Asset" 50.0
  submitMustFail borrower do exerciseCmd calledLoanCid TopUpCollateral with collateralCid = wrongAsset; topUpQuantity = 50.0; valuationCid = healthyMark
  outsider <- allocateParty "Outsider"
  wrongOwner <- issueCollateral issuer outsider tbill 50.0
  submitMustFail borrower do exerciseCmd calledLoanCid TopUpCollateral with collateralCid = wrongOwner; topUpQuantity = 50.0; valuationCid = healthyMark
  (exactCid, reserveCid) <- submit borrower do exerciseCmd oversized SplitCollateral with splitQuantity = 50.0
  toppedLoanCid <- submit borrower do exerciseCmd calledLoanCid TopUpCollateral with collateralCid = exactCid; topUpQuantity = 50.0; valuationCid = healthyMark
  Some toppedLoan <- queryContractId borrower toppedLoanCid
  toppedLoan.collateralQuantity === 200.0
  toppedLoan.marginCall === None
  Some reserve <- queryContractId borrower reserveCid
  reserve.quantity === 50.0

testMaturityOfferAndAcceptBoundaries : Script ()
testMaturityOfferAndAcceptBoundaries = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  -- Creation and acceptance are both valid strictly before maturity.
  offerCid <- makeOfferAt lender borrower regulator valuationAgent lenderCash initialMark shortMaturity
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  queryContractId borrower loanCid >>= \loan -> case loan of Some l -> l.maturity === shortMaturity; None -> abort "missing loan"

  ((issuer2, lender2, borrower2, regulator2, valuationAgent2, _), (initialMark2, lenderCash2, _, borrowerColl2)) <- setup
  offerCid2 <- makeOfferAt lender2 borrower2 regulator2 valuationAgent2 lenderCash2 initialMark2 shortMaturity
  passTime (seconds 60)
  submitMustFail borrower2 do exerciseCmd offerCid2 Accept with collateralCid = borrowerColl2; valuationCid = initialMark2
  cashAtExact <- issueCash issuer2 lender2 100.0
  submitMustFail lender2 do
    exerciseCmd cashAtExact MakeOffer with
      borrower = borrower2; regulator = regulator2; valuationAgent = valuationAgent2; valuationCid = initialMark2
      principal = 100.0; interest = 5.0; collateralAsset = tbill; collateralQuantity = 150.0
      maturity = shortMaturity; liquidationThresholdLtv = 90.0; marginCallWindowSeconds = 60
  passTime (seconds 1)
  cashAfter <- issueCash issuer2 lender2 100.0
  submitMustFail lender2 do
    exerciseCmd cashAfter MakeOffer with
      borrower = borrower2; regulator = regulator2; valuationAgent = valuationAgent2; valuationCid = initialMark2
      principal = 100.0; interest = 5.0; collateralAsset = tbill; collateralQuantity = 150.0
      maturity = shortMaturity; liquidationThresholdLtv = 90.0; marginCallWindowSeconds = 60

testMaturityMarginChoiceBoundaries : Script ()
testMaturityMarginChoiceBoundaries = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  offerCid <- makeOfferAt lender borrower regulator valuationAgent lenderCash initialMark shortMaturity
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  breachMark <- publishPrice valuationAgent initialMark 0.5
  calledLoanCid <- submit lender do exerciseCmd loanCid IssueMarginCall with valuationCid = breachMark
  passTime (seconds 60)
  submitMustFail borrower do exerciseCmd calledLoanCid ResolveMarginCall with valuationCid = breachMark
  passTime (seconds 1)
  submitMustFail borrower do exerciseCmd calledLoanCid ResolveMarginCall with valuationCid = breachMark

  ((issuer2, lender2, borrower2, regulator2, valuationAgent2, _), (initialMark2, lenderCash2, _, borrowerColl2)) <- setup
  now <- getTime
  let maturity2 = addRelTime now (seconds 60)
  offerCid2 <- makeOfferAt lender2 borrower2 regulator2 valuationAgent2 lenderCash2 initialMark2 maturity2
  loanCid2 <- acceptLoan borrower2 offerCid2 borrowerColl2 initialMark2
  breachMark2 <- publishPrice valuationAgent2 initialMark2 0.5
  passTime (seconds 60)
  submitMustFail lender2 do exerciseCmd loanCid2 IssueMarginCall with valuationCid = breachMark2

testOverdueLiquidation : Script ()
testOverdueLiquidation = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  offerCid <- makeOfferAt lender borrower regulator valuationAgent lenderCash initialMark shortMaturity
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  submitMustFail lender do exerciseCmd loanCid LiquidateOverdue
  passTime (seconds 60)
  submitMustFail lender do exerciseCmd loanCid LiquidateOverdue
  passTime (seconds 1)
  closedCid <- submit lender do exerciseCmd loanCid LiquidateOverdue
  Some closed <- queryContractId borrower closedCid
  closed.reason === "LiquidatedAtMaturity"
  closed.issuer === issuer
  closed.collateralReleased === False
  collateralQuantities lender >>= \quantities -> quantities === [150.0]
  query @CollateralHolding lender >>= \holdings -> [h.issuer | (_, h) <- holdings] === [issuer]
  query @Loan borrower >>= \loans -> length loans === 0

testOverdueLiquidationWithOpenCall : Script ()
testOverdueLiquidationWithOpenCall = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  offerCid <- makeOfferAt lender borrower regulator valuationAgent lenderCash initialMark (addRelTime testStart (seconds 120))
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  breachMark <- publishPrice valuationAgent initialMark 0.5
  calledLoanCid <- submit lender do exerciseCmd loanCid IssueMarginCall with valuationCid = breachMark
  healthyMark <- publishPrice valuationAgent breachMark 1.0
  Some healthy <- queryContractId borrower healthyMark
  healthy.unitPrice === 1.0
  passTime (seconds 120)
  submitMustFail lender do exerciseCmd calledLoanCid LiquidateOverdue
  passTime (seconds 1)
  closedCid <- submit lender do exerciseCmd calledLoanCid LiquidateOverdue
  Some closed <- queryContractId borrower closedCid
  closed.reason === "LiquidatedAtMaturity"
  closed.issuer === issuer
  collateralQuantities lender >>= \quantities -> quantities === [150.0]
  query @CollateralHolding lender >>= \holdings -> [h.issuer | (_, h) <- holdings] === [issuer]

testTopUpCannotCrossMaturity : Script ()
testTopUpCannotCrossMaturity = script do
  setTime testStart
  maturity <- pure (addRelTime testStart (seconds 120))
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  offerCid <- makeOfferAt lender borrower regulator valuationAgent lenderCash initialMark maturity
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  breachMark <- publishPrice valuationAgent initialMark 0.5
  calledLoanCid <- submit lender do exerciseCmd loanCid IssueMarginCall with valuationCid = breachMark
  extra <- issueCollateral issuer borrower tbill 50.0
  healthyMark <- publishPrice valuationAgent breachMark 0.8
  passTime (seconds 120)
  submitMustFail borrower do exerciseCmd calledLoanCid TopUpCollateral with collateralCid = extra; topUpQuantity = 50.0; valuationCid = healthyMark
  Some stillLoan <- queryContractId borrower calledLoanCid
  (stillLoan.marginCall /= None) === True
  passTime (seconds 1)
  _ <- submit lender do exerciseCmd calledLoanCid LiquidateOverdue
  query @Loan borrower >>= \loans -> length loans === 0

testValidationGuards : Script ()
testValidationGuards = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  submitMustFail lender do
    exerciseCmd lenderCash MakeOffer with
      borrower; regulator; valuationAgent; valuationCid = initialMark
      principal = 200.0; interest = 5.0; collateralAsset = tbill; collateralQuantity = 300.0
      maturity = maturityTime; liquidationThresholdLtv = 90.0; marginCallWindowSeconds = 60
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  wrongColl <- issueCollateral issuer borrower tbill 100.0
  submitMustFail borrower do exerciseCmd offerCid Accept with collateralCid = wrongColl; valuationCid = initialMark
  goodColl <- issueCollateral issuer borrower tbill 150.0
  loanCid <- acceptLoan borrower offerCid goodColl initialMark
  shortCash <- issueCash issuer borrower 50.0
  submitMustFail borrower do exerciseCmd loanCid Repay with repaymentCid = shortCash

testOfferAndSplitGuards : Script ()
testOfferAndSplitGuards = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, _)) <- setup
  submitMustFail lender do
    exerciseCmd lenderCash MakeOffer with
      borrower; regulator; valuationAgent
      valuationCid = initialMark
      principal = 100.0
      interest = 5.0
      collateralAsset = ""
      collateralQuantity = 150.0
      maturity = maturityTime
      liquidationThresholdLtv = 90.0
      marginCallWindowSeconds = 60
  cash <- issueCash issuer borrower 105.0
  submitMustFail borrower do exerciseCmd cash Split with splitAmount = 0.0
  submitMustFail borrower do exerciseCmd cash Split with splitAmount = 105.0
  submitMustFail borrower do exerciseCmd cash Split with splitAmount = 200.0
  collateral <- issueCollateral issuer borrower tbill 100.0
  submitMustFail borrower do exerciseCmd collateral SplitCollateral with splitQuantity = 0.0
  submitMustFail borrower do exerciseCmd collateral SplitCollateral with splitQuantity = 100.0
  submitMustFail borrower do exerciseCmd collateral SplitCollateral with splitQuantity = 200.0

testOriginationLtvGuards : Script ()
testOriginationLtvGuards = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, _)) <- setup

  -- At exactly 90% and above, MakeOffer must fail before consuming funding.
  submitMustFail lender do
    exerciseCmd lenderCash MakeOffer with
      borrower; regulator; valuationAgent; valuationCid = initialMark
      principal = 90.0
      interest = 5.0
      collateralAsset = tbill
      collateralQuantity = 100.0
      maturity = maturityTime
      liquidationThresholdLtv = 90.0
      marginCallWindowSeconds = 60
  submitMustFail lender do
    exerciseCmd lenderCash MakeOffer with
      borrower; regulator; valuationAgent; valuationCid = initialMark
      principal = 91.0
      interest = 5.0
      collateralAsset = tbill
      collateralQuantity = 100.0
      maturity = maturityTime
      liquidationThresholdLtv = 90.0
      marginCallWindowSeconds = 60
  cashAmounts lender >>= \amounts -> amounts === [100.0]
  query @LoanOffer borrower >>= \offers -> length offers === 0

  -- A strictly-below-threshold offer is accepted with the same exact mark.
  validOffer <- makeCustomOffer lender borrower regulator valuationAgent lenderCash initialMark 89.0 100.0 90.0 maturityTime
  validColl <- issueCollateral issuer borrower tbill 100.0
  loanCid <- acceptLoan borrower validOffer validColl initialMark
  Some loan <- queryContractId borrower loanCid
  loan.principal === 89.0
  loan.collateralQuantity === 100.0

testOriginationValuationGuards : Script ()
testOriginationValuationGuards = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, streamCid), (initialMark, lenderCash, _, _)) <- setup
  passTime (seconds 301)

  -- MakeOffer also requires the supplied mark to be current and stream-bound.
  submitMustFail lender do
    exerciseCmd lenderCash MakeOffer with
      borrower; regulator; valuationAgent; valuationCid = initialMark
      principal = 89.0; interest = 5.0; collateralAsset = tbill; collateralQuantity = 100.0
      maturity = maturityTime; liquidationThresholdLtv = 90.0; marginCallWindowSeconds = 60
  cashAmounts lender >>= \amounts -> amounts === [100.0]

  now <- getTime
  futureMark <- (actAs lender <> actAs borrower <> actAs valuationAgent) `submit` do
    createCmd CollateralValuation with
      valuationAgent; lender; borrower; regulator; collateralAsset = tbill
      streamId = streamCid; unitPrice = 1.0; observedAt = addRelTime now (seconds 1)
  submitMustFail lender do
    exerciseCmd lenderCash MakeOffer with
      borrower; regulator; valuationAgent; valuationCid = futureMark
      principal = 89.0; interest = 5.0; collateralAsset = tbill; collateralQuantity = 100.0
      maturity = maturityTime; liquidationThresholdLtv = 90.0; marginCallWindowSeconds = 60

  wrongAgent <- allocateParty "WrongAgent"
  wrongAgentMark <- (actAs wrongAgent <> actAs lender <> actAs borrower) `submit` do
    createCmd CollateralValuation with
      valuationAgent = wrongAgent; lender; borrower; regulator; collateralAsset = tbill
      streamId = streamCid; unitPrice = 1.0; observedAt = now
  submitMustFail lender do
    exerciseCmd lenderCash MakeOffer with
      borrower; regulator; valuationAgent; valuationCid = wrongAgentMark
      principal = 89.0; interest = 5.0; collateralAsset = tbill; collateralQuantity = 100.0
      maturity = maturityTime; liquidationThresholdLtv = 90.0; marginCallWindowSeconds = 60

  currentMark <- publishPrice valuationAgent initialMark 1.0
  validOffer <- makeCustomOffer lender borrower regulator valuationAgent lenderCash currentMark 89.0 100.0 90.0 maturityTime
  query @LoanOffer borrower >>= \offers -> length offers === 1

testAcceptancePriceDropAndRecovery : Script ()
testAcceptancePriceDropAndRecovery = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, _)) <- setup
  offerCid <- makeCustomOffer lender borrower regulator valuationAgent lenderCash initialMark 89.0 100.0 90.0 maturityTime
  collateralCid <- issueCollateral issuer borrower tbill 100.0

  -- The offer was valid at origination, but a live low mark must block acceptance.
  lowMark <- publishPrice valuationAgent initialMark 0.98
  submitMustFail borrower do exerciseCmd offerCid Accept with collateralCid; valuationCid = lowMark
  Some stillOffer <- queryContractId borrower offerCid
  stillOffer.collateralQuantity === 100.0
  Some stillCollateral <- queryContractId borrower collateralCid
  stillCollateral.quantity === 100.0
  cashAmounts borrower >>= \amounts -> amounts === [105.0]

  recoveryMark <- publishPrice valuationAgent lowMark 1.1
  loanCid <- acceptLoan borrower offerCid collateralCid recoveryMark
  Some loan <- queryContractId borrower loanCid
  loan.principal === 89.0
  loan.collateralQuantity === 100.0
  cashAmounts borrower >>= \amounts -> amounts === [89.0, 105.0]

testAcceptanceValuationGuards : Script ()
testAcceptanceValuationGuards = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, streamCid), (initialMark, lenderCash, _, _)) <- setup
  offerCid <- makeCustomOffer lender borrower regulator valuationAgent lenderCash initialMark 89.0 100.0 90.0 maturityTime
  collateralCid <- issueCollateral issuer borrower tbill 100.0

  -- The exact 300-second freshness boundary is handled separately below; at 301
  -- seconds the original mark is stale and cannot be used for acceptance.
  passTime (seconds 301)
  submitMustFail borrower do exerciseCmd offerCid Accept with collateralCid; valuationCid = initialMark
  currentMark <- publishPrice valuationAgent initialMark 1.0
  now <- getTime
  futureMark <- (actAs lender <> actAs borrower <> actAs valuationAgent) `submit` do
    createCmd CollateralValuation with
      valuationAgent; lender; borrower; regulator; collateralAsset = tbill
      streamId = streamCid; unitPrice = 1.0; observedAt = addRelTime now (seconds 1)
  submitMustFail borrower do exerciseCmd offerCid Accept with collateralCid; valuationCid = futureMark

  -- A replaced predecessor is archived even while it is otherwise fresh.
  replacementMark <- publishPrice valuationAgent currentMark 1.0
  submitMustFail borrower do exerciseCmd offerCid Accept with collateralCid; valuationCid = currentMark

  parallelStream <- createStream lender borrower regulator valuationAgent tbill
  parallelMark <- publishInitial valuationAgent parallelStream 1.0
  submitMustFail borrower do exerciseCmd offerCid Accept with collateralCid; valuationCid = parallelMark

  wrongAgent <- allocateParty "WrongAgent"
  wrongAgentMark <- (actAs wrongAgent <> actAs lender <> actAs borrower) `submit` do
    createCmd CollateralValuation with
      valuationAgent = wrongAgent; lender; borrower; regulator; collateralAsset = tbill
      streamId = streamCid; unitPrice = 1.0; observedAt = now
  submitMustFail borrower do exerciseCmd offerCid Accept with collateralCid; valuationCid = wrongAgentMark

  Some stillOffer <- queryContractId borrower offerCid
  stillOffer.collateralQuantity === 100.0
  Some stillCollateral <- queryContractId borrower collateralCid
  stillCollateral.quantity === 100.0
  cashAmounts borrower >>= \amounts -> amounts === [105.0]

testAcceptanceFreshnessBoundary : Script ()
testAcceptanceFreshnessBoundary = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, _)) <- setup
  offerCid <- makeCustomOffer lender borrower regulator valuationAgent lenderCash initialMark 89.0 100.0 90.0 maturityTime
  collateralCid <- issueCollateral issuer borrower tbill 100.0
  passTime (seconds 300)
  loanCid <- acceptLoan borrower offerCid collateralCid initialMark
  Some loan <- queryContractId borrower loanCid
  loan.principal === 89.0

  ((issuer2, lender2, borrower2, regulator2, valuationAgent2, _), (initialMark2, lenderCash2, _, _)) <- setup
  now <- getTime
  let maturity2 = addRelTime now (seconds 600)
  offerCid2 <- makeCustomOffer lender2 borrower2 regulator2 valuationAgent2 lenderCash2 initialMark2 89.0 100.0 90.0 maturity2
  collateralCid2 <- issueCollateral issuer2 borrower2 tbill 100.0
  passTime (seconds 301)
  submitMustFail borrower2 do exerciseCmd offerCid2 Accept with collateralCid = collateralCid2; valuationCid = initialMark2
  Some stillOffer <- queryContractId borrower2 offerCid2
  stillOffer.collateralQuantity === 100.0
  Some stillCollateral <- queryContractId borrower2 collateralCid2
  stillCollateral.quantity === 100.0

testDirectOfferAcceptanceGuard : Script ()
testDirectOfferAcceptanceGuard = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, streamCid), (initialMark, lenderCash, _, _)) <- setup

  -- Trusted issuance is a two-party operation. A lender alone cannot mint an
  -- issuer-signed offer even when every term is otherwise valid.
  submitMustFail lender do
    createCmd LoanOffer with
      issuer
      lender
      borrower
      regulator
      valuationAgent
      valuationStreamId = streamCid
      principal = 89.0
      interest = 5.0
      collateralAsset = tbill
      collateralQuantity = 100.0
      maturity = maturityTime
      liquidationThresholdLtv = 90.0
      marginCallWindowSeconds = 60
  -- Neither counterparty can mint the same trusted offer together without the
  -- issuer. This keeps the authorization failure independent of term checks.
  submitMustFail (actAs lender <> actAs borrower) do
    createCmd LoanOffer with
      issuer
      lender
      borrower
      regulator
      valuationAgent
      valuationStreamId = streamCid
      principal = 89.0
      interest = 5.0
      collateralAsset = tbill
      collateralQuantity = 100.0
      maturity = maturityTime
      liquidationThresholdLtv = 90.0
      marginCallWindowSeconds = 60

  -- A funded offer is valid at the healthy mark. At the exact 90% boundary
  -- after the mark falls to 1.0, Accept must fail while leaving both escrow
  -- and collateral live.
  healthyMark <- publishPrice valuationAgent initialMark 1.1
  fundedOffer <- makeCustomOffer lender borrower regulator valuationAgent lenderCash healthyMark 90.0 100.0 90.0 maturityTime
  collateralCid <- issueCollateral issuer borrower tbill 100.0
  boundaryMark <- publishPrice valuationAgent healthyMark 1.0
  submitMustFail borrower do exerciseCmd fundedOffer Accept with collateralCid; valuationCid = boundaryMark
  Some stillOffer <- queryContractId borrower fundedOffer
  stillOffer.principal === 90.0
  Some stillCollateral <- queryContractId borrower collateralCid
  stillCollateral.quantity === 100.0
  cashAmounts lender >>= \amounts -> amounts === [10.0]

-- Every trusted holding and lifecycle record includes the issuer as a
-- signatory. Counterparties cannot mint a record that merely names the issuer.
testIssuerAuthorizationBoundaries : Script ()
testIssuerAuthorizationBoundaries = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, streamCid), (initialMark, _, _, _)) <- setup

  submitMustFail lender do
    createCmd CashHolding with issuer; owner = lender; amount = 1.0
  submitMustFail borrower do
    createCmd CollateralHolding with issuer; owner = borrower; asset = tbill; quantity = 1.0

  let directLoan = do
        createCmd Loan with
          issuer
          lender
          borrower
          regulator
          valuationAgent
          valuationStreamId = streamCid
          principal = 100.0
          interest = 5.0
          collateralAsset = tbill
          collateralQuantity = 150.0
          maturity = maturityTime
          liquidationThresholdLtv = 90.0
          marginCallWindowSeconds = 60
          marginCall = None
          collateralLocked = True
          amountRepaid = None
  submitMustFail lender directLoan
  submitMustFail borrower directLoan
  submitMustFail (actAs lender <> actAs borrower) directLoan

  -- A counterparty cannot substitute itself for the issuer. Both records have
  -- otherwise valid terms and both counterparties authorize the create, so
  -- these failures exercise the role-distinctness invariant.
  submitMustFail (actAs lender <> actAs borrower) do
    createCmd LoanOffer with
      issuer = lender
      lender
      borrower
      regulator
      valuationAgent
      valuationStreamId = streamCid
      principal = 89.0
      interest = 5.0
      collateralAsset = tbill
      collateralQuantity = 100.0
      maturity = maturityTime
      liquidationThresholdLtv = 90.0
      marginCallWindowSeconds = 60
  submitMustFail (actAs lender <> actAs borrower) do
    createCmd LoanOffer with
      issuer = borrower
      lender
      borrower
      regulator
      valuationAgent
      valuationStreamId = streamCid
      principal = 89.0
      interest = 5.0
      collateralAsset = tbill
      collateralQuantity = 100.0
      maturity = maturityTime
      liquidationThresholdLtv = 90.0
      marginCallWindowSeconds = 60
  submitMustFail (actAs lender <> actAs borrower) do
    createCmd Loan with
      issuer = lender
      lender
      borrower
      regulator
      valuationAgent
      valuationStreamId = streamCid
      principal = 100.0
      interest = 5.0
      collateralAsset = tbill
      collateralQuantity = 150.0
      maturity = maturityTime
      liquidationThresholdLtv = 90.0
      marginCallWindowSeconds = 60
      marginCall = None
      collateralLocked = True
      amountRepaid = None
  submitMustFail (actAs lender <> actAs borrower) do
    createCmd Loan with
      issuer = borrower
      lender
      borrower
      regulator
      valuationAgent
      valuationStreamId = streamCid
      principal = 100.0
      interest = 5.0
      collateralAsset = tbill
      collateralQuantity = 150.0
      maturity = maturityTime
      liquidationThresholdLtv = 90.0
      marginCallWindowSeconds = 60
      marginCall = None
      collateralLocked = True
      amountRepaid = None

  let directClosed = do
        createCmd LoanClosed with
          issuer
          lender
          borrower
          regulator
          valuationAgent
          valuationStreamId = streamCid
          principal = 100.0
          interest = 5.0
          collateralAsset = tbill
          collateralQuantity = 150.0
          maturity = maturityTime
          reason = "Repaid"
          collateralReleased = True
          amountRepaid = None
  submitMustFail (actAs lender <> actAs borrower) directClosed
  submitMustFail (actAs lender <> actAs borrower) do
    createCmd LoanClosed with
      issuer = lender
      lender
      borrower
      regulator
      valuationAgent
      valuationStreamId = streamCid
      principal = 100.0
      interest = 5.0
      collateralAsset = tbill
      collateralQuantity = 150.0
      maturity = maturityTime
      reason = "Repaid"
      collateralReleased = True
      amountRepaid = None
  submitMustFail (actAs lender <> actAs borrower) do
    createCmd LoanClosed with
      issuer = borrower
      lender
      borrower
      regulator
      valuationAgent
      valuationStreamId = streamCid
      principal = 100.0
      interest = 5.0
      collateralAsset = tbill
      collateralQuantity = 150.0
      maturity = maturityTime
      reason = "Repaid"
      collateralReleased = True
      amountRepaid = None

-- The offer is the escrow. Its principal is conserved while reserved, and a
-- refund restores the exact amount for both exact and oversized funding.
testFundingConservationExactAndOversized : Script ()
testFundingConservationExactAndOversized = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, _)) <- setup
  exactOffer <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  cashAmounts lender >>= \amounts -> amounts === []
  Some exact <- queryContractId lender exactOffer
  exact.principal === 100.0
  exact.issuer === issuer
  _ <- submit lender do exerciseCmd exactOffer Withdraw
  cashAmounts lender >>= \amounts -> amounts === [100.0]

  ((issuer2, lender2, borrower2, regulator2, valuationAgent2, _), (initialMark2, _, _, _)) <- setup
  oversizedCash <- issueCash issuer2 lender2 150.0
  oversizedOffer <- makeOffer lender2 borrower2 regulator2 valuationAgent2 oversizedCash initialMark2
  cashAmounts lender2 >>= \amounts -> amounts === [50.0, 100.0]
  Some oversized <- queryContractId lender2 oversizedOffer
  oversized.principal === 100.0
  oversized.issuer === issuer2
  _ <- submit lender2 do exerciseCmd oversizedOffer Withdraw
  cashAmounts lender2 >>= \amounts -> amounts === [50.0, 100.0, 100.0]

-- Consuming choices on an offer are one-shot. The funding input is consumed by
-- MakeOffer and cannot be reused, while Accept and Withdraw race exactly once.
testEscrowOneShotChoices : Script ()
testEscrowOneShotChoices = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  withdrawnOffer <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  _ <- submit lender do exerciseCmd withdrawnOffer Withdraw
  submitMustFail lender do exerciseCmd withdrawnOffer Withdraw
  submitMustFail borrower do exerciseCmd withdrawnOffer Accept with collateralCid = borrowerColl; valuationCid = initialMark
  submitMustFail lender do
    exerciseCmd lenderCash MakeOffer with
      borrower; regulator; valuationAgent; valuationCid = initialMark
      principal = 100.0; interest = 5.0; collateralAsset = tbill; collateralQuantity = 150.0
      maturity = maturityTime; liquidationThresholdLtv = 90.0; marginCallWindowSeconds = 60

  ((issuer2, lender2, borrower2, regulator2, valuationAgent2, _), (initialMark2, lenderCash2, _, borrowerColl2)) <- setup
  acceptedOffer <- makeOffer lender2 borrower2 regulator2 valuationAgent2 lenderCash2 initialMark2
  _ <- acceptLoan borrower2 acceptedOffer borrowerColl2 initialMark2
  submitMustFail borrower2 do exerciseCmd acceptedOffer Accept with collateralCid = borrowerColl2; valuationCid = initialMark2
  submitMustFail lender2 do exerciseCmd acceptedOffer Withdraw

-- A failed acceptance must not consume either side: the lender can still
-- withdraw the reserved principal after the borrower submits bad collateral.
testFailedAcceptLeavesReserveForWithdraw : Script ()
testFailedAcceptLeavesReserveForWithdraw = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, _)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  badCollateral <- issueCollateral issuer borrower tbill 149.0
  submitMustFail borrower do exerciseCmd offerCid Accept with collateralCid = badCollateral; valuationCid = initialMark
  Some stillOffer <- queryContractId lender offerCid
  stillOffer.principal === 100.0
  Some stillCollateral <- queryContractId borrower badCollateral
  stillCollateral.quantity === 149.0
  _ <- submit lender do exerciseCmd offerCid Withdraw
  cashAmounts lender >>= \amounts -> amounts === [100.0]

-- A collateral or repayment cash holding from another issuer is rejected and
-- remains unconsumed. Trusted-issuer controls then prove each rejection is due
-- to issuer provenance rather than a generic ownership or amount guard.
testCounterfeitIssuerRejectedAtAcceptTopUpAndRepay : Script ()
testCounterfeitIssuerRejectedAtAcceptTopUpAndRepay = script do
  setTime testStart
  fakeIssuer <- allocateParty "CounterfeitIssuer"
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, _)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  fakeCollateral <- issueCollateral fakeIssuer borrower tbill 150.0
  submitMustFail borrower do exerciseCmd offerCid Accept with collateralCid = fakeCollateral; valuationCid = initialMark
  Some stillFakeCollateral <- queryContractId borrower fakeCollateral
  stillFakeCollateral.quantity === 150.0
  Some stillOffer <- queryContractId borrower offerCid
  stillOffer.principal === 100.0
  trustedCollateral <- issueCollateral issuer borrower tbill 150.0
  _ <- acceptLoan borrower offerCid trustedCollateral initialMark

  fakeIssuer2 <- allocateParty "CounterfeitIssuerTopUp"
  ((issuer2, lender2, borrower2, regulator2, valuationAgent2, _), (initialMark2, lenderCash2, _, borrowerColl2)) <- setup
  offerCid2 <- makeOffer lender2 borrower2 regulator2 valuationAgent2 lenderCash2 initialMark2
  loanCid2 <- acceptLoan borrower2 offerCid2 borrowerColl2 initialMark2
  breachMark <- publishPrice valuationAgent2 initialMark2 0.5
  calledLoanCid <- submit lender2 do exerciseCmd loanCid2 IssueMarginCall with valuationCid = breachMark
  healthyMark <- publishPrice valuationAgent2 breachMark 0.8
  fakeTopUp <- issueCollateral fakeIssuer2 borrower2 tbill 50.0
  submitMustFail borrower2 do
    exerciseCmd calledLoanCid TopUpCollateral with
      collateralCid = fakeTopUp; topUpQuantity = 50.0; valuationCid = healthyMark
  Some stillFakeTopUp <- queryContractId borrower2 fakeTopUp
  stillFakeTopUp.quantity === 50.0
  trustedTopUp <- issueCollateral issuer2 borrower2 tbill 50.0
  toppedLoanCid <- submit borrower2 do
    exerciseCmd calledLoanCid TopUpCollateral with
      collateralCid = trustedTopUp; topUpQuantity = 50.0; valuationCid = healthyMark
  Some toppedLoan <- queryContractId borrower2 toppedLoanCid
  toppedLoan.collateralQuantity === 200.0

  fakeIssuer3 <- allocateParty "CounterfeitIssuerRepay"
  ((issuer3, lender3, borrower3, regulator3, valuationAgent3, _), (initialMark3, lenderCash3, _, borrowerColl3)) <- setup
  offerCid3 <- makeOffer lender3 borrower3 regulator3 valuationAgent3 lenderCash3 initialMark3
  loanCid3 <- acceptLoan borrower3 offerCid3 borrowerColl3 initialMark3
  fakeCash <- issueCash fakeIssuer3 borrower3 105.0
  submitMustFail borrower3 do exerciseCmd loanCid3 Repay with repaymentCid = fakeCash
  Some stillFakeCash <- queryContractId borrower3 fakeCash
  stillFakeCash.amount === 105.0
  Some stillLoan <- queryContractId borrower3 loanCid3
  stillLoan.principal === 100.0
  trustedCash <- issueCash issuer3 borrower3 105.0
  _ <- submit borrower3 do exerciseCmd loanCid3 Repay with repaymentCid = trustedCash
  query @Loan borrower3 >>= \loans -> length loans === 0

-- Issuers can read every issuer-signed position. The valuer is intentionally
-- excluded from offer/loan/close visibility, and an unrelated outsider sees
-- none of the private lifecycle records.
testIssuerVisibilityAndValuerOutsiderBoundaries : Script ()
testIssuerVisibilityAndValuerOutsiderBoundaries = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  outsider <- allocateParty "Outsider"
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  query @LoanOffer issuer >>= \offers -> length offers === 1
  query @LoanOffer lender >>= \offers -> length offers === 1
  query @LoanOffer borrower >>= \offers -> length offers === 1
  query @LoanOffer regulator >>= \offers -> length offers === 1
  query @LoanOffer valuationAgent >>= \offers -> length offers === 0
  query @LoanOffer outsider >>= \offers -> length offers === 0
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  query @Loan issuer >>= \loans -> length loans === 1
  query @Loan lender >>= \loans -> length loans === 1
  query @Loan borrower >>= \loans -> length loans === 1
  query @Loan regulator >>= \loans -> length loans === 1
  query @Loan valuationAgent >>= \loans -> length loans === 0
  query @Loan outsider >>= \loans -> length loans === 0
  repaymentCid <- issueCash issuer borrower 105.0
  closedCid <- submit borrower do exerciseCmd loanCid Repay with repaymentCid
  query @LoanClosed issuer >>= \closed -> length closed === 1
  query @LoanClosed lender >>= \closed -> length closed === 1
  query @LoanClosed borrower >>= \closed -> length closed === 1
  query @LoanClosed regulator >>= \closed -> length closed === 1
  query @LoanClosed valuationAgent >>= \closed -> length closed === 0
  query @LoanClosed outsider >>= \closed -> length closed === 0

mmf : Text
mmf = "Tokenized MMF"

-- An active loan on the fixture's T-Bill stream plus an agreed MMF stream at
-- 1.0 and a 160-unit MMF holding the borrower can offer as a replacement.
substitutionSetup : Script ((Party, Party, Party, Party, Party), (ContractId Loan, ContractId CollateralValuation, ContractId ValuationStream, ContractId CollateralValuation, ContractId CollateralHolding, ContractId CashHolding))
substitutionSetup = do
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, borrowerCash, borrowerColl)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  mmfStream <- createStream lender borrower regulator valuationAgent mmf
  mmfMark <- publishInitial valuationAgent mmfStream 1.0
  mmfHolding <- issueCollateral issuer borrower mmf 160.0
  pure ((issuer, lender, borrower, regulator, valuationAgent), (loanCid, initialMark, mmfStream, mmfMark, mmfHolding, borrowerCash))

proposeSubstitution : Party -> Party -> Party -> Party -> ContractId CollateralHolding -> ContractId ValuationStream -> Decimal -> Script (ContractId SubstitutionRequest)
proposeSubstitution borrower lender regulator valuationAgent holdingCid streamCid releaseQuantity =
  submit borrower do
    exerciseCmd holdingCid ProposeSubstitution with
      lender; regulator; valuationAgent
      releaseAsset = tbill
      releaseQuantity
      newValuationStreamId = streamCid

testCollateralSubstitutionLifecycle : Script ()
testCollateralSubstitutionLifecycle = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent), (loanCid, tbillMark, mmfStream, mmfMark, mmfHolding, borrowerCash)) <- substitutionSetup
  outsider <- allocateParty "Outsider"
  requestCid <- proposeSubstitution borrower lender regulator valuationAgent mmfHolding mmfStream 150.0
  -- The replacement is escrowed: the borrower no longer holds it freely.
  collateralQuantities borrower >>= \quantities -> quantities === []
  query @SubstitutionRequest lender >>= \requests -> length requests === 1
  query @SubstitutionRequest regulator >>= \requests -> length requests === 1
  query @SubstitutionRequest valuationAgent >>= \requests -> length requests === 0
  query @SubstitutionRequest outsider >>= \requests -> length requests === 0
  -- Only the lender can apply it.
  submitMustFail borrower do exerciseCmd loanCid ApplySubstitution with requestCid; newValuationCid = mmfMark
  swappedCid <- submit lender do exerciseCmd loanCid ApplySubstitution with requestCid; newValuationCid = mmfMark
  Some swapped <- queryContractId regulator swappedCid
  swapped.collateralAsset === mmf
  swapped.collateralQuantity === 160.0
  swapped.valuationStreamId === mmfStream
  swapped.issuer === issuer
  -- The released T-Bills are back in the borrower's wallet, with the issuer.
  released <- query @CollateralHolding borrower
  [(h.asset, h.quantity, h.issuer) | (_, h) <- released] === [(tbill, 150.0, issuer)]
  -- Margin actions now price the MMF stream; the old T-Bill mark no longer fits.
  stressedTbill <- publishPrice valuationAgent tbillMark 0.5
  submitMustFail lender do exerciseCmd swappedCid IssueMarginCall with valuationCid = stressedTbill
  stressedMmf <- publishPrice valuationAgent mmfMark 0.6
  calledCid <- submit lender do exerciseCmd swappedCid IssueMarginCall with valuationCid = stressedMmf
  healthyMmf <- publishPrice valuationAgent stressedMmf 1.0
  curedCid <- submit borrower do exerciseCmd calledCid ResolveMarginCall with valuationCid = healthyMmf
  closedCid <- submit borrower do exerciseCmd curedCid Repay with repaymentCid = borrowerCash
  Some closed <- queryContractId regulator closedCid
  closed.collateralAsset === mmf
  closed.collateralQuantity === 160.0
  returned <- query @CollateralHolding borrower
  sort [(h.asset, h.quantity) | (_, h) <- returned] === [(mmf, 160.0), (tbill, 150.0)]

testSubstitutionGuards : Script ()
testSubstitutionGuards = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent), (loanCid, tbillMark, mmfStream, mmfMark, mmfHolding, _)) <- substitutionSetup
  -- Coverage: 100 principal against 100 MMF at 1.0 is exactly 100% LTV.
  (small, _) <- submit borrower do exerciseCmd mmfHolding SplitCollateral with splitQuantity = 100.0
  weakRequest <- proposeSubstitution borrower lender regulator valuationAgent small mmfStream 150.0
  submitMustFail lender do exerciseCmd loanCid ApplySubstitution with requestCid = weakRequest; newValuationCid = mmfMark
  -- The rejected request refunds exactly once.
  refundCid <- submit lender do exerciseCmd weakRequest RejectSubstitution
  submitMustFail lender do exerciseCmd weakRequest RejectSubstitution
  Some refund <- queryContractId borrower refundCid
  (refund.asset, refund.quantity, refund.issuer) === (mmf, 100.0, issuer)
  -- A mark from the old asset's stream cannot price the replacement.
  replacement <- issueCollateral issuer borrower mmf 160.0
  request <- proposeSubstitution borrower lender regulator valuationAgent replacement mmfStream 150.0
  submitMustFail lender do exerciseCmd loanCid ApplySubstitution with requestCid = request; newValuationCid = tbillMark
  -- A stale replacement mark is rejected at the 301-second boundary.
  setTime (addRelTime testStart (seconds 301))
  submitMustFail lender do exerciseCmd loanCid ApplySubstitution with requestCid = request; newValuationCid = mmfMark
  freshMmf <- publishPrice valuationAgent mmfMark 1.0
  freshTbill <- publishPrice valuationAgent tbillMark 1.0
  -- An open margin call blocks substitution; it must be cured first.
  stressedTbill <- publishPrice valuationAgent freshTbill 0.6
  calledCid <- submit lender do exerciseCmd loanCid IssueMarginCall with valuationCid = stressedTbill
  submitMustFail lender do exerciseCmd calledCid ApplySubstitution with requestCid = request; newValuationCid = freshMmf
  recoveredTbill <- publishPrice valuationAgent stressedTbill 1.0
  curedCid <- submit borrower do exerciseCmd calledCid ResolveMarginCall with valuationCid = recoveredTbill
  -- A request naming collateral the loan no longer holds is stale.
  staleRequestHolding <- issueCollateral issuer borrower mmf 160.0
  staleRequest <- proposeSubstitution borrower lender regulator valuationAgent staleRequestHolding mmfStream 999.0
  submitMustFail lender do exerciseCmd curedCid ApplySubstitution with requestCid = staleRequest; newValuationCid = freshMmf
  _ <- submit borrower do exerciseCmd staleRequest CancelSubstitution
  submitMustFail borrower do exerciseCmd staleRequest CancelSubstitution
  -- The valid request still applies; applying it twice is impossible.
  swappedCid <- submit lender do exerciseCmd curedCid ApplySubstitution with requestCid = request; newValuationCid = freshMmf
  submitMustFail lender do exerciseCmd swappedCid ApplySubstitution with requestCid = request; newValuationCid = freshMmf
  Some swapped <- queryContractId lender swappedCid
  (swapped.collateralAsset, swapped.collateralQuantity) === (mmf, 160.0)
  pure ()

testSubstitutionMaturityAndAuthority : Script ()
testSubstitutionMaturityAndAuthority = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent), (loanCid, _, mmfStream, mmfMark, mmfHolding, _)) <- substitutionSetup
  request <- proposeSubstitution borrower lender regulator valuationAgent mmfHolding mmfStream 150.0
  -- Only the borrower may cancel; only the lender may reject.
  submitMustFail lender do exerciseCmd request CancelSubstitution
  submitMustFail borrower do exerciseCmd request RejectSubstitution
  -- A lender cannot fabricate a request without the borrower and issuer.
  submitMustFail lender do
    createCmd SubstitutionRequest with
      issuer; lender; borrower; regulator; valuationAgent
      releaseAsset = tbill; releaseQuantity = 150.0
      newAsset = mmf; newQuantity = 1000.0; newValuationStreamId = mmfStream
  setTime maturityTime
  freshMmf <- publishPrice valuationAgent mmfMark 1.0
  submitMustFail lender do exerciseCmd loanCid ApplySubstitution with requestCid = request; newValuationCid = freshMmf
  pure ()

-- An active 100 principal + 5 interest loan on 150 T-Bill units at 1.0, and
-- extra borrower cash for paydowns.
paydownSetup : Script ((Party, Party, Party, Party, Party), (ContractId Loan, ContractId CollateralValuation, ContractId CashHolding))
paydownSetup = do
  ((issuer, lender, borrower, regulator, valuationAgent, _), (initialMark, lenderCash, _, borrowerColl)) <- setup
  offerCid <- makeOffer lender borrower regulator valuationAgent lenderCash initialMark
  loanCid <- acceptLoan borrower offerCid borrowerColl initialMark
  paydownCash <- issueCash issuer borrower 200.0
  pure ((issuer, lender, borrower, regulator, valuationAgent), (loanCid, initialMark, paydownCash))

payDown : Party -> ContractId Loan -> ContractId CashHolding -> Decimal -> Optional (ContractId CollateralValuation) -> Script (ContractId Loan, ContractId CashHolding)
payDown borrower loanCid cashCid amount valuationCid = do
  (exact, rest) <- submit borrower do exerciseCmd cashCid Split with splitAmount = amount
  loanCid' <- submit borrower do exerciseCmd loanCid PartialRepay with paymentCid = exact; valuationCid
  pure (loanCid', rest)

testPartialRepaymentLifecycle : Script ()
testPartialRepaymentLifecycle = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, _), (loanCid, _, cash)) <- paydownSetup
  (paidCid, rest) <- payDown borrower loanCid cash 30.0 None
  Some paid <- queryContractId regulator paidCid
  paid.amountRepaid === Some 30.0
  (paid.principal, paid.interest) === (100.0, 5.0)
  cashAmounts lender >>= \amounts -> amounts === [30.0]
  -- 30 paid: 5 interest, 25 principal. The final repayment is exactly 75.
  (wrongAmount, rest2) <- submit borrower do exerciseCmd rest Split with splitAmount = 105.0
  submitMustFail borrower do exerciseCmd paidCid Repay with repaymentCid = wrongAmount
  _ <- submit borrower do exerciseCmd wrongAmount Split with splitAmount = 75.0
  finalCash <- query @CashHolding borrower
  let [(finalCid, _)] = filter (\(_, h) -> h.amount == 75.0) finalCash
  closedCid <- submit borrower do exerciseCmd paidCid Repay with repaymentCid = finalCid
  Some closed <- queryContractId regulator closedCid
  closed.reason === "Repaid"
  closed.amountRepaid === Some 105.0
  closed.issuer === issuer
  cashAmounts lender >>= \amounts -> amounts === [30.0, 75.0]
  collateralQuantities borrower >>= \quantities -> quantities === [150.0]
  Some _ <- queryContractId borrower rest2
  pure ()

testPartialRepaymentCuresMarginCall : Script ()
testPartialRepaymentCuresMarginCall = script do
  setTime testStart
  ((_, lender, borrower, regulator, valuationAgent), (loanCid, mark, cash)) <- paydownSetup
  stressed <- publishPrice valuationAgent mark 0.62
  calledCid <- submit lender do exerciseCmd loanCid IssueMarginCall with valuationCid = stressed
  (exact20, rest) <- submit borrower do exerciseCmd cash Split with splitAmount = 20.0
  -- During a call the payment needs a fresh mark and must restore LTV.
  submitMustFail borrower do exerciseCmd calledCid PartialRepay with paymentCid = exact20; valuationCid = None
  -- 20 leaves 85 principal: 85 / (150 * 0.62) = 91.4%, still a breach.
  submitMustFail borrower do exerciseCmd calledCid PartialRepay with paymentCid = exact20; valuationCid = Some stressed
  (exact30, _) <- submit borrower do exerciseCmd rest Split with splitAmount = 30.0
  setTime (addRelTime testStart (seconds 301))
  submitMustFail borrower do exerciseCmd calledCid PartialRepay with paymentCid = exact30; valuationCid = Some stressed
  fresh <- publishPrice valuationAgent stressed 0.62
  -- 30 leaves 75 principal: 75 / 93 = 80.6%, which cures the call.
  curedCid <- submit borrower do exerciseCmd calledCid PartialRepay with paymentCid = exact30; valuationCid = Some fresh
  Some cured <- queryContractId regulator curedCid
  cured.marginCall === None
  cured.amountRepaid === Some 30.0
  -- A new call is judged on the reduced principal: 80.6% is no breach.
  submitMustFail lender do exerciseCmd curedCid IssueMarginCall with valuationCid = fresh
  -- The unused 20 is still the borrower's.
  Some _ <- queryContractId borrower exact20
  pure ()

testPartialRepaymentGuards : Script ()
testPartialRepaymentGuards = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent), (loanCid, mark, cash)) <- paydownSetup
  (full, rest) <- submit borrower do exerciseCmd cash Split with splitAmount = 105.0
  -- Paying the whole balance must go through Repay so collateral is released.
  submitMustFail borrower do exerciseCmd loanCid PartialRepay with paymentCid = full; valuationCid = None
  -- Only the borrower may pay, with the loan's issuer.
  (ten, rest2) <- submit borrower do exerciseCmd rest Split with splitAmount = 10.0
  submitMustFail lender do exerciseCmd loanCid PartialRepay with paymentCid = ten; valuationCid = None
  otherIssuer <- allocateParty "OtherIssuer"
  foreign <- issueCash otherIssuer borrower 10.0
  submitMustFail borrower do exerciseCmd loanCid PartialRepay with paymentCid = foreign; valuationCid = None
  -- Liquidation after a paydown keeps the running total on the record.
  (paidCid, _) <- payDown borrower loanCid rest2 55.0 None
  deep <- publishPrice valuationAgent mark 0.4
  -- 50 principal left: 50 / 60 = 83.3%, no breach at a price that would
  -- have breached the original 100.
  submitMustFail lender do exerciseCmd paidCid IssueMarginCall with valuationCid = deep
  deeper <- publishPrice valuationAgent deep 0.3
  calledCid <- submit lender do exerciseCmd paidCid IssueMarginCall with valuationCid = deeper
  setTime (addRelTime testStart (seconds 61))
  freshDeep <- publishPrice valuationAgent deeper 0.3
  closedCid <- submit lender do exerciseCmd calledCid Liquidate with valuationCid = freshDeep
  Some closed <- queryContractId regulator closedCid
  closed.reason === "Liquidated"
  closed.amountRepaid === Some 55.0
  closed.issuer === issuer
  pure ()

testPartialRepaymentMaturity : Script ()
testPartialRepaymentMaturity = script do
  setTime testStart
  ((_, _, borrower, _, _), (loanCid, _, cash)) <- paydownSetup
  (ten, _) <- submit borrower do exerciseCmd cash Split with splitAmount = 10.0
  setTime maturityTime
  submitMustFail borrower do exerciseCmd loanCid PartialRepay with paymentCid = ten; valuationCid = None
  pure ()


noExtra : ExtraArgs
noExtra = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

-- An offer secured by 150 Canton Coin at a CC price of 1.0, with mock registry
-- factories standing in for the DSO.
coinSetup : Script ((Party, Party, Party, Party, Party, Party), (ContractId CoinLoanOffer, ContractId CollateralValuation, ContractId MockAllocationFactory, ContractId MockSettlementFactory, ContractId CashHolding))
coinSetup = do
  ((issuer, lender, borrower, regulator, valuationAgent, _), (_, lenderCash, borrowerCash, _)) <- setup
  dso <- allocateParty "DSO"
  ccStream <- createStream lender borrower regulator valuationAgent "Canton Coin"
  ccMark <- publishInitial valuationAgent ccStream 1.0
  allocFactory <- submit dso do createCmd MockAllocationFactory with admin = dso; users = [borrower, lender]
  settleFactory <- submit dso do createCmd MockSettlementFactory with admin = dso; users = [lender]
  offerCid <- submit lender do
    exerciseCmd lenderCash MakeCoinOffer with
      borrower; regulator; valuationAgent
      valuationCid = ccMark
      coinAdmin = dso
      principal = 100.0; interest = 5.0; collateralQuantity = 150.0
      maturity = maturityTime; liquidationThresholdLtv = 90.0; marginCallWindowSeconds = 60
      settlementRef = "veil-coin-1"
  pure ((issuer, lender, borrower, regulator, valuationAgent, dso), (offerCid, ccMark, allocFactory, settleFactory, borrowerCash))

acceptCoin : Party -> ContractId CoinLoanOffer -> ContractId CollateralValuation -> ContractId MockAllocationFactory -> Script (ContractId CoinLoan)
acceptCoin borrower offerCid mark factory =
  submit borrower do
    exerciseCmd offerCid AcceptCoin with
      valuationCid = mark
      allocationFactoryCid = toInterfaceContractId factory
      inputHoldingCids = []
      extraArgs = noExtra

testCoinLoanRepayReleasesCollateral : Script ()
testCoinLoanRepayReleasesCollateral = script do
  setTime testStart
  ((issuer, lender, borrower, regulator, valuationAgent, _), (offerCid, mark, factory, _, borrowerCash)) <- coinSetup
  loanCid <- acceptCoin borrower offerCid mark factory
  -- The Canton Coin sits in one committed allocation executed only by the lender.
  [(allocCid, alloc)] <- query @MockAllocation borrower
  alloc.allocation.committed === True
  alloc.settlement.executors === [lender]
  alloc.settlement.id === "veil-coin-1"
  alloc.allocation.settlementDeadline === Some (addRelTime maturityTime (days 1))
  query @MockAllocation lender >>= \as -> length as === 1
  -- The token standard refuses the borrower's early withdrawal.
  submitMustFail borrower do
    exerciseCmd (toInterfaceContractId @Token.Allocation allocCid) Token.Allocation_Withdraw with actors = [borrower]; extraArgs = noExtra
  Some loan <- queryContractId regulator loanCid
  loan.allocationCid === toInterfaceContractId allocCid
  query @CoinLoan valuationAgent >>= \ls -> length ls === 0
  cashAmounts borrower >>= \amounts -> amounts === [100.0, 105.0]
  closedCid <- submit borrower do exerciseCmd loanCid RepayCoin with repaymentCid = borrowerCash; cancelExtraArgs = noExtra
  Some closed <- queryContractId regulator closedCid
  (closed.reason, closed.collateralAsset, closed.collateralQuantity, closed.collateralReleased) === ("Repaid", "Canton Coin", 150.0, True)
  closed.issuer === issuer
  query @MockAllocation borrower >>= \as -> length as === 0

testCoinLiquidationSettlesToLender : Script ()
testCoinLiquidationSettlesToLender = script do
  setTime testStart
  ((_, lender, borrower, regulator, valuationAgent, _), (offerCid, mark, factory, settle, _)) <- coinSetup
  loanCid <- acceptCoin borrower offerCid mark factory
  stressed <- publishPrice valuationAgent mark 0.62
  calledCid <- submit lender do exerciseCmd loanCid IssueCoinMarginCall with valuationCid = stressed
  receipt <- submit lender do exerciseCmd calledCid PrepareCoinReceipt with allocationFactoryCid = toInterfaceContractId factory; extraArgs = noExtra
  -- Liquidation waits for the call deadline.
  submitMustFail lender do
    exerciseCmd calledCid LiquidateCoin with valuationCid = stressed; settlementFactoryCid = toInterfaceContractId settle; receiptAllocationCid = receipt; extraArgs = noExtra
  setTime (addRelTime testStart (seconds 61))
  fresh <- publishPrice valuationAgent stressed 0.62
  -- A receiving allocation that does not mirror the locked collateral is refused.
  Some loan <- queryContractId lender calledCid
  wrongReceipt <- submit lender do
    exerciseCmd (toInterfaceContractId @Instr.AllocationFactory factory) Instr.AllocationFactory_Allocate with
      settlement = coinSettlement lender loan.settlementRef
      allocation = coinAllocationSpec loan.coinAdmin lender False (coinCollateralLeg Token.ReceiverSide borrower 1.0) loan.maturity
      requestedAt = addRelTime testStart (seconds 61)
      inputHoldingCids = []
      extraArgs = noExtra
      actors = [lender]
  Instr.AllocationInstructionResult_Completed wrongCid <- pure wrongReceipt.output
  submitMustFail lender do
    exerciseCmd calledCid LiquidateCoin with valuationCid = fresh; settlementFactoryCid = toInterfaceContractId settle; receiptAllocationCid = wrongCid; extraArgs = noExtra
  closedCid <- submit lender do
    exerciseCmd calledCid LiquidateCoin with valuationCid = fresh; settlementFactoryCid = toInterfaceContractId settle; receiptAllocationCid = receipt; extraArgs = noExtra
  Some closed <- queryContractId regulator closedCid
  (closed.reason, closed.collateralReleased) === ("Liquidated", False)
  -- Only the unused wrong receipt remains.
  query @MockAllocation lender >>= \as -> map (\(cid, _) -> toInterfaceContractId @Token.Allocation cid) as === [wrongCid]

testCoinLoanGuards : Script ()
testCoinLoanGuards = script do
  setTime testStart
  ((_, lender, borrower, regulator, valuationAgent, _), (offerCid, mark, factory, settle, borrowerCash)) <- coinSetup
  -- A factory run by any other admin cannot lock the collateral.
  impostor <- allocateParty "Impostor"
  fakeFactory <- submit impostor do createCmd MockAllocationFactory with admin = impostor; users = [borrower]
  submitMustFail borrower do
    exerciseCmd offerCid AcceptCoin with valuationCid = mark; allocationFactoryCid = toInterfaceContractId fakeFactory; inputHoldingCids = []; extraArgs = noExtra
  -- A stressed CC price blocks acceptance.
  stressed <- publishPrice valuationAgent mark 0.62
  submitMustFail borrower do
    exerciseCmd offerCid AcceptCoin with valuationCid = stressed; allocationFactoryCid = toInterfaceContractId factory; inputHoldingCids = []; extraArgs = noExtra
  healthy <- publishPrice valuationAgent stressed 1.0
  loanCid <- acceptCoin borrower offerCid healthy factory
  -- Only the lender releases the collateral; a pay-down cures a call as before.
  submitMustFail borrower do exerciseCmd loanCid WriteOffCoin with cancelExtraArgs = noExtra
  stressed2 <- publishPrice valuationAgent healthy 0.62
  calledCid <- submit lender do exerciseCmd loanCid IssueCoinMarginCall with valuationCid = stressed2
  (thirty, _) <- submit borrower do exerciseCmd borrowerCash Split with splitAmount = 30.0
  curedCid <- submit borrower do exerciseCmd calledCid PartialRepayCoin with paymentCid = thirty; valuationCid = Some stressed2
  Some cured <- queryContractId regulator curedCid
  (cured.marginCall, cured.amountRepaid) === (None, Some 30.0)
  -- Overdue liquidation needs maturity to have passed.
  receipt <- submit lender do exerciseCmd curedCid PrepareCoinReceipt with allocationFactoryCid = toInterfaceContractId factory; extraArgs = noExtra
  submitMustFail lender do
    exerciseCmd curedCid LiquidateCoinOverdue with settlementFactoryCid = toInterfaceContractId settle; receiptAllocationCid = receipt; extraArgs = noExtra
  setTime (addRelTime maturityTime (seconds 1))
  closedCid <- submit lender do
    exerciseCmd curedCid LiquidateCoinOverdue with settlementFactoryCid = toInterfaceContractId settle; receiptAllocationCid = receipt; extraArgs = noExtra
  Some closed <- queryContractId regulator closedCid
  (closed.reason, closed.amountRepaid) === ("LiquidatedAtMaturity", Some 30.0)
  pure ()

testCoinWriteOffReleases : Script ()
testCoinWriteOffReleases = script do
  setTime testStart
  ((_, lender, borrower, regulator, _, _), (offerCid, mark, factory, _, _)) <- coinSetup
  loanCid <- acceptCoin borrower offerCid mark factory
  closedCid <- submit lender do exerciseCmd loanCid WriteOffCoin with cancelExtraArgs = noExtra
  Some closed <- queryContractId regulator closedCid
  (closed.reason, closed.collateralReleased) === ("WrittenOff", True)
  query @MockAllocation borrower >>= \as -> length as === 0
