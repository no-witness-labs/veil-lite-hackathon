-- | Stand-ins for a Token Standard registry (Canton Coin, USDCx, CBTC) that
-- implement the V2 interfaces with the same authorization and committed-lock
-- rules: only executors settle or cancel, a committed allocation cannot be
-- withdrawn before its settlement deadline, and a batch settles only legs that
-- its allocations describe exactly.
module Veil.TokenMocks where

import DA.Action (when)
import DA.Foldable (forA_)
import DA.Map qualified as Map
import DA.Optional (fromSome)
import Splice.Api.Token.AllocationInstructionV2 qualified as Instr
import Splice.Api.Token.AllocationV2 qualified as Token
import Splice.Api.Token.MetadataV1

-- No observers: like the real registry, callers see it only via disclosure.
template MockAllocationFactory
  with
    admin : Party
  where
    signatory admin

    interface instance Instr.AllocationFactory for MockAllocationFactory where
      view = Instr.AllocationFactoryView with admin; meta = emptyMetadata
      allocationFactory_publicFetchImpl _ _ = pure Instr.AllocationFactoryView with admin; meta = emptyMetadata
      allocationFactory_allocateExtraObservers _ = []
      allocationFactory_allocateImpl _ arg = do
        assertMsg "only the authorizer may allocate" (arg.actors == [fromSome arg.allocation.authorizer.owner])
        assertMsg "allocation admin must be this registry" (arg.allocation.admin == admin)
        cid <- create MockAllocation with settlement = arg.settlement; allocation = arg.allocation
        pure Instr.AllocationInstructionResult with
          output = Instr.AllocationInstructionResult_Completed with allocationCid = toInterfaceContractId cid
          authorizerChangeCids = mempty
          meta = emptyMetadata

template MockAllocation
  with
    settlement : Token.SettlementInfo
    allocation : Token.AllocationSpecification
  where
    signatory allocation.admin, fromSome allocation.authorizer.owner
    observer settlement.executors

    interface instance Token.Allocation for MockAllocation where
      view = Token.AllocationView with
        originalAllocationCid = None
        settlement
        allocation
        holdingCids = []
        createdAt = fromSome allocation.settlementDeadline
        numIterations = 0
        expiresAt = allocation.settlementDeadline
        availableActions = Map.empty
        meta = emptyMetadata
      allocation_settleImpl self arg = do
        assertMsg "only executors settle" (arg.actors == settlement.executors)
        now <- getTime
        forA_ allocation.settlementDeadline $ \d -> assertMsg "settlement deadline passed" (now <= d)
        archive (fromInterfaceContractId @MockAllocation self)
        pure Token.AllocationResult with
          output = Token.AllocationResult_Settled with nextIterationAllocationCid = None
          authorizerHoldingCids = mempty
          meta = emptyMetadata
      allocation_cancelImpl self arg = do
        assertMsg "only executors cancel" (arg.actors == settlement.executors)
        archive (fromInterfaceContractId @MockAllocation self)
        pure Token.AllocationResult with output = Token.AllocationResult_Cancelled; authorizerHoldingCids = mempty; meta = emptyMetadata
      allocation_withdrawImpl self arg = do
        assertMsg "only the authorizer withdraws" (arg.actors == [fromSome allocation.authorizer.owner])
        now <- getTime
        when allocation.committed $
          assertMsg "cannot withdraw a committed allocation before its settlement deadline"
            (maybe False (now >) allocation.settlementDeadline)
        archive (fromInterfaceContractId @MockAllocation self)
        pure Token.AllocationResult with output = Token.AllocationResult_Withdrawn; authorizerHoldingCids = mempty; meta = emptyMetadata
      allocation_settleExtraObservers _ = []
      allocation_cancelExtraObservers _ = []
      allocation_withdrawExtraObservers _ = []

-- No observers: like the real registry, callers see it only via disclosure.
template MockSettlementFactory
  with
    admin : Party
  where
    signatory admin

    interface instance Token.SettlementFactory for MockSettlementFactory where
      view = Token.SettlementFactoryView with admin; meta = emptyMetadata
      settlementFactory_publicFetchImpl _ _ = pure Token.SettlementFactoryView with admin; meta = emptyMetadata
      settlementFactory_settleBatchExtraObservers _ = []
      settlementFactory_settleBatchImpl _ arg = do
        -- Every leg side of every allocation must match a leg of the batch.
        forA_ arg.allocations $ \a -> do
          v <- view <$> fetch a.allocationCid
          assertMsg "allocation belongs to another settlement" (v.settlement == arg.settlement)
          assertMsg "allocation belongs to another registry" (v.allocation.admin == admin)
          let authorizer = v.allocation.authorizer
          forA_ v.allocation.transferLegSides $ \s ->
            assertMsg "allocation does not match a leg of the batch" $ any (\leg ->
              leg.transferLegId == s.transferLegId && leg.amount == s.amount && leg.instrumentId == s.instrumentId
                && case s.side of
                     Token.SenderSide -> leg.sender == authorizer && leg.receiver == s.otherside
                     Token.ReceiverSide -> leg.receiver == authorizer && leg.sender == s.otherside)
              arg.transferLegs
        results <- forA arg.allocations $ \a -> exercise a.allocationCid Token.Allocation_Settle with
          actors = arg.actors
          extraTransferLegSides = a.extraTransferLegSides
          nextIterationFunding = a.nextIterationFunding
          extraArgs = arg.extraArgs
        pure Token.SettlementFactory_SettleBatchResult with allocationSettleResults = results; meta = emptyMetadata
