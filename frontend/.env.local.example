# The local authenticated sandbox needs no .env.local file. Startup generates
# .local/auth/public.pem and frontend/public/ledger-config.json automatically.
# Restart Vite after restarting/bootstraping Canton so its party map is current.
# See docs/AUTH.md. Never put tokens or private keys in VITE_* variables.

# A separately provisioned participant must trust the same JWT signer/audience
# and have the restricted veil-{role} users. This is not the old shared Seaport
# OIDC proxy; client-credentials substitution is no longer supported.
# VEIL_LEDGER_TARGET=https://your-participant.example
# VEIL_AUTH_PUBLIC_KEY_FILE=/absolute/path/to/public.pem
# VEIL_AUTH_AUDIENCE=veil-local
# On Vercel use VEIL_AUTH_PUBLIC_KEY with the PEM contents instead of a file.
# JWT issuer must be veil-local and subject must be a supported veil-{role}.

# Required for hosted config; local Vite reads the generated ledger-config.json.
# VEIL_PARTY_LENDER=Lender::<participant-fingerprint>
# VEIL_PARTY_BORROWER=Borrower::<participant-fingerprint>
# VEIL_PARTY_REGULATOR=Regulator::<participant-fingerprint>
# VEIL_PARTY_VALUER=Valuer::<participant-fingerprint>
# VEIL_PARTY_OUTSIDER=Outsider::<participant-fingerprint>
# VEIL_PARTY_ISSUER=DemoIssuer::<participant-fingerprint>
