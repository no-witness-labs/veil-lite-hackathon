# The local authenticated sandbox needs no .env.local file. Startup generates
# .local/auth/public.pem and frontend/public/ledger-config.json automatically.
# Restart Vite after restarting/bootstrapping Canton so its party map is current.
# See docs/AUTH.md. Never put tokens or private keys in VITE_* variables.

# Shared HackCanton DevNet node (docs/DEVNET.md, docs/VERCEL.md). Setting the
# refresh token switches the proxy to submit with the team's ledger-user token.
# VEIL_LEDGER_TARGET=https://ledger-api-json.participant.hackcanton-01.devnet.naas.noders.services
# VEIL_OIDC_TOKEN_URL=https://keycloak.naas.noders.services/realms/noders-appsfactory/protocol/openid-connect/token
# VEIL_OIDC_CLIENT_ID=web-app-ui-hackcanton-01-devnet
# VEIL_LEDGER_USER_ID=<ledger user id>
# VEIL_UPSTREAM_REFRESH_TOKEN=<secret: refresh_token from .local/devnet/tokens.json>

# Passcode sign-in (disabled unless both are set; passcodes need 12+ characters).
# VEIL_AUTH_PRIVATE_KEY=<secret: PEM that signs role tokens>
# VEIL_DEMO_PASSCODE=<secret>
# VEIL_OPERATOR_PASSCODE=<secret, different from the demo passcode>

# Role-token verification (defaults to .local/auth/public.pem and veil-local).
# VEIL_AUTH_PUBLIC_KEY_FILE=/absolute/path/to/public.pem
# VEIL_AUTH_AUDIENCE=veil-local

# Required for hosted config; local Vite reads the generated ledger-config.json.
# VEIL_PARTY_LENDER=<namespace>veil-lender::<participant-fingerprint>
# VEIL_PARTY_BORROWER=<namespace>veil-borrower::<participant-fingerprint>
# VEIL_PARTY_REGULATOR=<namespace>veil-regulator::<participant-fingerprint>
# VEIL_PARTY_VALUER=<namespace>veil-valuer::<participant-fingerprint>
# VEIL_PARTY_OUTSIDER=<namespace>veil-outsider::<participant-fingerprint>
# VEIL_PARTY_ISSUER=<namespace>veil-issuer::<participant-fingerprint>
